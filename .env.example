# === Vague-Finder 환경 변수 예시 ===
# 이 파일을 .env로 복사해 값을 채운다. .env는 git 추적 대상이 아니다.
# 키와 데이터 경로는 팀 드라이브를 참고할 것.
#
#   cp .env.example .env
#
# 검색만 돌릴 때 꼭 필요한 것: Gemini 설정(아래 3 — Vertex AI 프로젝트 + 인증)과 Qdrant 적재(docs/vector_backend.md)
# 주석(#)으로 둔 줄은 코드 기본값이다. 바꿀 때만 주석을 푼다.
#
# 쓰지 않는 옛 키 — .env에 남아 있으면 지운다
#   GEMINI_API_KEY · GOOGLE_API_KEY      AI Studio 경로 폐기(2026-10-15). 남아 있으면 읽지 않고 경고만 한다
#   QDRANT_HYBRID_SCAN_LIMIT             하이브리드 조회 상한 폐기(v62). 남아 있으면 기동 때 경고만, 조회에는 효과 없음
#   RERANKER_BACKEND=claude_listwise     Claude 리랭커 철회(2026-10-15). 기동에서 설정 오류로 멈춘다
#   PROJECT_NAME · ENV_MODE              코드가 읽지 않는다

# 1. 벡터 DB — Qdrant (설치·적재 절차는 docs/vector_backend.md)
QDRANT_PATH=artifacts/qdrant         # 로컬 모드 저장 위치 (git 추적 안 함)
# QDRANT_URL=                        # 서버·클라우드를 쓸 때만. 있으면 QDRANT_PATH는 무시
# QDRANT_API_KEY=
# 컬렉션 이름은 <이름>__<네임스페이스>다. 바꾸면 다시 적재해야 한다.
# QDRANT_TEXT_COLLECTION="vaguefinder-text-1024-koe5"
# QDRANT_IMAGE_COLLECTION="vaguefinder-image-768"
# QDRANT_AUDIO_COLLECTION="vaguefinder-audio-512"
# QDRANT_NAMESPACE="dev"

# 2. MongoDB — 가사 정확 일치 검색과 정답 피드백 저장
#    없으면 가사 경로만 비고 나머지 검색은 그대로 동작한다
MONGO_URI="mongodb://localhost:27017"
MONGO_DB_NAME="vaguefinder"
# LYRICS_CACHE_TTL_SECONDS=300       # 가사 스냅숏 TTL. 지나면 기존 판으로 검색하며 백그라운드로 한 번 갱신
# LYRICS_REFRESH_RETRY_SECONDS=60    # 갱신이 실패하면 이 시간 동안 다시 시도하지 않는다

# 3. Gemini — 질의 분석·리랭킹·작품명 해석·크롤링 정제에 필수. **Vertex AI 전용**(src/common/gemini_client.py)
#    인증은 둘 중 하나. .env 값만으로는 호출되지 않는다.
#    ① 서비스 계정 키(팀원·Docker 권장): 팀 드라이브 vague-finder/secrets/vertex-sa.json을 레포의 secrets/ 폴더에 두고
#       아래 GOOGLE_APPLICATION_CREDENTIALS를 켠다. 상대 경로는 레포 루트 기준이라 venv와 Docker(/app) 모두 같은 줄로 된다.
#       secrets/는 git·Docker 이미지에서 제외돼 있다. 키 파일을 메신저·공개 저장소에 올리지 않는다.
#    ② 개인 ADC: 그 프로젝트에 초대된 Google 계정으로 `gcloud auth application-default login`을 한 번 실행한다.
#       Docker에서는 컨테이너에 ADC가 없어 ①을 쓴다.
#    서버는 기동에서 설정·인증·모델을 확인하고(무료 countTokens 1회) 틀리면 뜨지 않는다. 분석 캐시 생성·측정 도구도 같다.
GCP_PROJECT_ID=
GCP_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=secrets/vertex-sa.json   # ①. 개인 ADC(②)를 쓰면 이 줄을 지운다 — 파일이 없으면 기동에서 멈춘다
GEMINI_MODEL_NAME=gemini-3.1-flash-lite        # 검색(질의 분석·리랭커·작품명 해석) 모델. 바꾸면 검색 기준선과 비교할 수 없다
GEMINI_CRAWL_MODEL_NAME=gemini-3.5-flash-lite  # 크롤링(정제·댓글 선별·Context 추출) 모델 — 검색 모델과 따로 간다
# 검색 경로 설정(호환용) — 비우거나 vertex. 옛 api_key·ai_studio·auto는 설정 오류(기동에서 멈춤).
# 측정 runinfo와 분석 캐시 지문에 남는다. AI Studio로 잰 옛 기준선(v32~v47)과는 직접 비교하지 않는다(docs/search_models.md)
GEMINI_RETRIEVAL_BACKEND=vertex
# QUERY_ANALYSIS_TIMEOUT_SECONDS=20  # 질의 분석 전체(재시도 포함) 시간 제한. 넘기면 규칙 폴백으로 검색을 마친다
# SEARCH_WARMUP=1                    # 0이면 서버 기동 직후 예열을 건너뛴다(진행 상태는 /health)

# 상대적 시기("작년", "최근 나온")를 해석하는 기준 연도. 비우면 실행 시점의 연도를 쓰는데, 해가 바뀌면
# 같은 질의의 분석이 달라지므로 고정한다. 분석 캐시 생성(build_analysis_cache)은 이 값이 없으면 거부한다.
SEARCH_REFERENCE_YEAR=2026

# 4. 리랭커 — 기본 Gemini listwise(1패스 · Google Search 끔). 근거: results_v32~v34, src/backend/api/dependencies.py
#    Gemini 설정이 없으면 서버는 기동 검사에서 멈추고, 서버 밖 도구에서는 Cross-Encoder로 내려간다. 모르는 값은 기동·측정 시작에서 오류
# RERANKER_BACKEND=gemini_listwise   # cross_encoder면 CE(v22·v27~v31 기준선 재현용)
# RERANKER_ENABLED=true
# GEMINI_RERANK_WEIGHT=0.85
# GEMINI_RERANK_PASSES=1              # 2면 Hit@10 +1에 리랭킹 약 10초
# GEMINI_RERANK_USE_SEARCH=0          # 1이면 Google Search grounding — Hit@1·MRR ↑, 리랭킹 13~15초
# GEMINI_RERANK_RARE_FACT_VERIFY=0    # 1이면 희소 단서 질의에 Google Search 교차검증 — 품질 이득 없음(results_v35)
# GEMINI_RERANK_MAX_CANDIDATES=30
# GEMINI_RERANK_TIMEOUT_SECONDS=20    # Gemini 호출 1회의 HTTP 연결·읽기 제한
# GEMINI_RERANK_BUDGET_SECONDS=30     # 리랭킹 1회 전체 예산. 넘기면 남은 호출을 건너뛰고 검색 순서 + failed
# GEMINI_RERANK_PASS_RESERVE_SECONDS=10  # 예산 중 본 패스 몫(검증 배치가 예산을 다 써도 본 패스가 한 번은 돈다)
# 재질문 답을 리랭커에 넘기는 방식(실험, results_clarify_v10_corrections · v11_prebonus)
# GEMINI_RERANK_CORRECTIONS=all       # new_only면 원래 분석과 같은 답은 프롬프트에서 뺀다
# GEMINI_RERANK_TYPE_SLOT_LABEL=      # 재질문 type 슬롯 문구. 기본 "artist type (solo/group/duo/band)"
# CLARIFY_RERANK_INPUT_ORDER=bonus    # pre_bonus | placebo:<seed>

# Cross-Encoder 전용 — RERANKER_BACKEND=cross_encoder일 때만 쓰인다
# 합성 계수 둘은 쌍이다(한쪽만 바꾸면 측정한 적 없는 조합). CE 민감도 = WEIGHT / SPREAD_REF (= 45)
RERANKER_WEIGHT=0.45
RERANKER_SPREAD_REF=0.01
# 앞 N개만 채점(검색 후보 풀 30은 그대로). 0이면 전체 채점. 바꾸면 서버를 다시 띄워야 적용된다(results_v21_ce_topn)
RERANKER_SCORE_TOP_N=20
# CE spread가 이 값보다 작으면 재정렬 생략(0이면 끔). 2026-09-23 결정: 꺼짐
RERANKER_MIN_SPREAD=0

# 검색 가산·보호 — 값은 현행(측정 기준선 조건)이다
LYRIC_PROTECT_PHONETIC_TOP1=0         # 1이면 검색 1위 phonetic 가사 일치도 보호. 2026-09-23 결정: 꺼짐
LYRIC_PROTECT_MIN_CONFIDENCE=0.80     # 가사 표면 일치 보호 문턱. 1.0을 넘기면 보호가 전부 꺼진다(진단용)
LYRIC_BOOST_SCALE=1.0                 # 가사 가산 배율. 0이면 매칭·후보 유입은 두고 가산만 끈다
BOOST_SCALE=1.0                       # 명시 가산 전체 배율. 0.2는 채택 안 함(results_v27_boost_scale)
ATTR_BOOST_SCALE=1.0                  # 일반 속성 가산(성별·시기·형태·편성·장르)에만 곱하는 배율(results_v31_attr_boost_scale)
GENDER_MISMATCH_SCALE=0               # 보컬 성별 불일치 감점. 0 = 감점 없음, 1.0이면 예전 감점
GENRE_MATCH_SCALE=1.0                 # 최초 질의 장르 일치 가산 배율(0~1, experiments/genre_memory_gap)
GENRE_ANSWER_SCALE=1.0                # 재질문 장르 답 가산 배율(0~1)
# AUDIO_FUSION_SCALE=1.0             # 소리 경로(CLAP) 융합 가중 배율. 0이면 소리 경로를 돌리지 않는다(실험, results_v68·v69·v75)

# 속성 조건 보조 후보 — 기본 꺼짐(실험, results_v51~v55). 시기 창과 성별/장르/형태 조건에 맞는 곡 안에서
# 한 번 더 검색해 낮은 RRF 가중으로 더한다
ATTR_FILTER_WEIGHT=0                  # RRF 가중. 0 = 경로 없음. 측정값은 0.5
ATTR_FILTER_GATE=era_plus             # era_plus(시기 창 + 다른 축 1개 이상) | two_axes(비교용)
ATTR_FILTER_K=30                      # 보조 검색으로 받는 곡 수(1~100)
ATTR_FILTER_USE_GENRE=1               # 0이면 장르를 필터 축에서 뺀다(v53)
ATTR_FILTER_GENRE_POLICY=always       # conditional이면 재질문 장르 답·성별 조건에 따라 장르 축을 넣거나 뺀다(v54)

# 작품명 해석 — 기본 꺼짐(results_v70~v75). "그 드라마 OST"처럼 간접 지칭한 작품을 Gemini로 해석해 보조 후보를 더한다
# WORK_NAME_RESOLUTION_ENABLED=0     # 1만 켠다. 그 밖의 값은 설정 오류
# WORK_NAME_RESOLVER=vertex          # vertex | cache:<경로>(평가 고정용, 호출 없음)
# WORK_NAME_AUX_WEIGHT=0.5           # 보조 후보 가중(0~2)
# WORK_NAME_RESOLVER_TIMEOUT_SECONDS=4.0
# WORK_MENTIONS_PATH=artifacts/work_names/work_mentions_v1.json.gz

# 배경 사실(나무위키 Context) 경로. 서버가 기동 때 읽는다(src/retrieval/context_search_settings.py, 아래가 코드 기본값과 같다).
# CONTEXT_WEIGHT > 0 이면 기동 때 Context 별칭·컬렉션·manifest·로컬 artifact 해시를 확인하고, 설정 오류면 서버가 뜨지 않는다
# (연결 장애는 경고만, /health.context=unavailable). Context 색인이 없는 환경은 0으로 둔다 — 경로와 검사를 함께 끈다.
# 절차: docs/namuwiki_context_vector_db.md "기동 검사"
CONTEXT_WEIGHT=0.5
CONTEXT_NAMED_MEDIA_MULTIPLIER=2.0
CONTEXT_FACT_K=100
CONTEXT_SPARSE_K=100
SEARCH_DEFAULT_CANDIDATE_K=30

# 5. 정답 피드백 — 세 스위치는 서로 독립이고 모두 기본 꺼짐(docs/feedback.md)
FEEDBACK_COLLECTION_ENABLED=0         # 켜면 검색 표시 기록과 정답·사유를 Mongo에 30일 보관
FEEDBACK_CORPUS_VERSION=unknown       # 코퍼스 배포판 식별값. 예: corpus5143-20261012-bm25-bf606b19ab02. 수집을 켜기 전에 정한다
FEEDBACK_INDEX_WORKER_ENABLED=0       # 승인 사례 색인 + 만료·무효 사례 정리(검색 서버 안 스레드). 수집을 꺼도 켤 수 있다
FEEDBACK_RETRIEVAL_ENABLED=0          # 승인 사례로 검색 후보 보충. 평가 기준(docs/feedback.md §8)을 넘긴 뒤에만 켠다
# 잠정값. 범위를 벗어나거나 nan·inf면 기본값으로 읽는다
# FEEDBACK_MIN_SIMILARITY=0.65       # 질의와 사례 문장의 코사인 유사도 문턱
# FEEDBACK_SUPPLEMENT_SONGS=3        # 한 검색에서 보충할 곡 수 상한
# FEEDBACK_FUSION_WEIGHT=1.0         # 진입 판정 점수 = 밀려날 꼬리 후보의 융합 점수 × 이 값
# FEEDBACK_LOOKUP_BUDGET_SECONDS=0.6 # 기존 경로가 끝난 뒤 보충을 더 기다리는 상한
# FEEDBACK_WORKER_INTERVAL_SECONDS=60
# 로컬 검토 화면(venv/bin/python -m src.feedback.review_app). loopback에서만 뜬다
# FEEDBACK_REVIEW_PORT=8001
# FEEDBACK_REVIEWER=                 # 검토 기록에 남길 이름(로컬 설정값 — 확인된 신원이 아니다)

# 6. 크롤러·임베딩 — 수집·임베딩을 돌리는 사람만 필요
#    크롤링에 필수인 것은 Gemini 설정(3)과 VAGUEFINDER_DATA_DIR 둘뿐이다.
#    별도 설치: Node.js(yt-dlp의 JS 엔진), ffmpeg(오디오 m4a 디코딩)
#    수집 폴더는 팀 구글 드라이브를 가리켜야 한다. **적지 않으면 저장소 안(data/raw)에 쌓인다.**
#    Windows: VAGUEFINDER_DATA_DIR="C:\\Users\\<사용자>\\My Drive\\vague-finder\\raw5"
#    macOS:   VAGUEFINDER_DATA_DIR="/Users/<사용자>/Library/CloudStorage/GoogleDrive-<계정>/내 드라이브/vague-finder/raw5"
VAGUEFINDER_DATA_DIR=
# VAGUEFINDER_STAGING_DIR=           # 진행 중인 곡 폴더. 기본값은 DATA_DIR + "_incomplete"
# ENABLE_NAMUWIKI=0                  # flat 나무위키 수집은 은퇴했다(#67)
#
# 임베딩(src.embedding.cli.run_demo) — 전체 곡 세트로 돌릴 때는 실행 줄에서 VAGUEFINDER_DATA_DIR·META_*를 함께 준다(CLAUDE.md)
# EMBED_TEXT=1                       # 모달리티별로 0이면 건너뛴다
# EMBED_IMAGE=1
# EMBED_AUDIO=1
# META_VALIDATION=1                  # 메타 검증. 켜면 검증 실패 곡이 빠진다
# META_MOVE_INVALID=1                # 검증 실패 곡 폴더를 *_failed로 옮긴다
# TEXT_DENSE_BATCH=64                # MPS 메모리 부족이면 8
# IMAGE_BATCH=32                     # MPS 메모리 부족이면 8
# 오디오 임베딩 — 아래 값을 바꾸면 곡 벡터와 평균 벡터가 재생성되고(전처리 지문이 manifest에 기록) Qdrant 재적재가 필요하다
# AUDIO_DECODER=ffmpeg               # torchaudio는 비교 측정용이며 실패 시 예외가 난다
# CLAP_SEED=0                        # CLAP 특징 추출 구간 선택 시드. 재현성을 위해 고정
