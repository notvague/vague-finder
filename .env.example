# === Vague-Finder 환경 변수 예시 ===
# 이 파일을 .env로 복사해 값을 채운다. .env는 git 추적 대상이 아니다.
# 키와 데이터 경로는 팀 드라이브를 참고할 것.
#
#   cp .env.example .env
#
# 검색만 돌릴 때 꼭 필요한 것: Gemini 설정(아래 3 — Vertex AI 프로젝트 + ADC)과 Qdrant 적재(docs/vector_backend.md)

# 1. 프로젝트
PROJECT_NAME="Vague-Finder"
ENV_MODE="development"

# 2. 벡터 DB — Qdrant
#    설치·적재 절차는 docs/vector_backend.md
QDRANT_PATH=artifacts/qdrant         # 로컬 모드 저장 위치 (git 추적 안 함)
# QDRANT_URL=                        # 서버·클라우드를 쓸 때만. 있으면 QDRANT_PATH는 무시
# QDRANT_API_KEY=
#   하이브리드 합산은 요청마다 count(exact)로 센 대상 수만큼 전수 조회한다(v62, 2026-10-16). 옛 QDRANT_HYBRID_SCAN_LIMIT은
#   폐기됐다 — 남아 있으면 기동 때 경고 한 번, 조회에는 효과 없음. .env에서 지운다
# 컬렉션 이름은 <이름>__<네임스페이스>다. 바꾸면 다시 적재해야 한다. 보통은 기본값을 쓴다.
# QDRANT_TEXT_COLLECTION="vaguefinder-text-1024-koe5"
# QDRANT_IMAGE_COLLECTION="vaguefinder-image-768"
# QDRANT_AUDIO_COLLECTION="vaguefinder-audio-512"
# QDRANT_NAMESPACE="dev"

# 3. Gemini — 질의 분석·리랭킹·크롤링 정제에 필수. **Vertex AI 전용**(2026-10-15, src/common/gemini_client.py)
#    인증은 둘 중 하나. .env 값만으로는 호출되지 않는다.
#    ① 서비스 계정 키(팀원·Docker 권장): 팀 드라이브 vague-finder/secrets/vertex-sa.json을 레포의 secrets/ 폴더에 두고
#       아래 GOOGLE_APPLICATION_CREDENTIALS를 켠다. 상대 경로는 레포 루트 기준이라 venv와 Docker(/app) 모두 같은 줄로 된다.
#       secrets/는 git·Docker 이미지에서 제외돼 있다. 키 파일을 메신저·공개 저장소에 올리지 않는다.
#    ② 개인 ADC: 그 프로젝트에 초대된 Google 계정으로 `gcloud auth application-default login`을 한 번 실행한다.
#       브라우저 로그인이나 `gcloud auth login`만으로는 Python의 인증이 바뀌지 않는다. Docker에서는 컨테이너에 ADC가 없어 ①을 쓴다.
#    프로젝트는 결제 계정(체험 크레딧)에 연결돼 있고 Vertex AI API가 켜져 있어야 한다.
#    서버는 기동에서 설정·인증·모델을 확인하고(무료 countTokens 1회) 틀리면 뜨지 않는다. 분석 캐시 생성·측정 도구도 같다.
GCP_PROJECT_ID=
GCP_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=secrets/vertex-sa.json   # ①. 개인 ADC(②)를 쓰면 이 줄을 지운다 — 파일이 없으면 기동에서 멈춘다
#    AI Studio API 키 경로는 없다 — GEMINI_API_KEY·GOOGLE_API_KEY가 남아 있어도 읽지 않는다(경고만). 지운다.
GEMINI_MODEL_NAME=gemini-3.1-flash-lite        # 검색(질의 분석·리랭커) 모델. 바꾸면 검색 기준선과 비교할 수 없다
GEMINI_CRAWL_MODEL_NAME=gemini-3.5-flash-lite  # 크롤링(정제·댓글 선별·Context 추출) 모델 — 검색 모델과 따로 간다. 비우면 이 기본값
#    검색 경로 설정(호환용) — 비우거나 vertex. 옛 api_key·ai_studio·auto는 설정 오류(기동에서 멈춤).
#    측정 runinfo의 gemini.backend·location·setting과 분석 캐시 지문(gemini_backend)에 남는다. 같은 모델 이름이라도
#    AI Studio와 Vertex는 출력이 달라(results_clarify_v11_prebonus), AI Studio로 잰 옛 기준선(v32~v47·봉인 test·재질문 v09)과는
#    직접 비교하지 않는다 — Vertex 기준선은 docs/search_models.md.
GEMINI_RETRIEVAL_BACKEND=vertex

# 4. 리랭커 — 기본 Gemini listwise(1패스 · Google Search 끔), 2026-10-09 전환
#    세 질의 세트 154건에서 CE 대비 엄격 Hit@10 0.630 → 0.740, Hit@1 53 → 78, 이탈 0 (results_v32~v34).
#    리랭킹 중앙값 1.8초 → 4.5~5.4초. Gemini(Vertex AI) 설정(GCP_PROJECT_ID)이 없으면 Cross-Encoder로 내려간다.
#    CE로 돌리려면(v22·v27~v31 기준선 재현): RERANKER_BACKEND=cross_encoder
#    비우면 gemini_listwise다. 모르는 값·제거된 claude_listwise는 기동·측정 시작에서 오류 — 조용히 CE로 내려가지 않는다
# RERANKER_BACKEND=gemini_listwise
# RERANKER_ENABLED=true
# GEMINI_RERANK_WEIGHT=0.85
# GEMINI_RERANK_PASSES=1              # 2면 Hit@10 +1에 리랭킹 약 10초
# GEMINI_RERANK_USE_SEARCH=0          # 1이면 Google Search grounding — Hit@1·MRR ↑, 리랭킹 13~15초
# GEMINI_RERANK_RARE_FACT_VERIFY=0    # 1이면 드라마·OST 등 희소 단서 질의에 Google Search 교차검증 — 품질 이득 없음(results_v35), 해당 질의 리랭킹 +11초
# GEMINI_RERANK_MAX_CANDIDATES=30
# GEMINI_RERANK_TIMEOUT_SECONDS=20    # Gemini 호출 1회의 HTTP 연결·읽기 제한
# GEMINI_RERANK_BUDGET_SECONDS=30     # 리랭킹 1회 전체 예산. 호출마다 벽시계 제한 = min(요청 제한, 남은 예산)으로 진행 중 연결까지 취소하고,
#                                     # 넘기면 남은 호출을 건너뛰며 늦게 온 응답은 버린다 — 검색 순서 + failed (최악 ≈ 예산)
# GEMINI_RERANK_CORRECTIONS=all       # new_only면 원래 질의 분석과 같은 값을 확인해 준 재질문 답은 LLM 프롬프트에서 뺀다 (실험, results_clarify_v10_corrections)
# GEMINI_RERANK_TYPE_SLOT_LABEL=      # 재질문 type 슬롯 문구. 기본 "artist type (solo/group/duo/band)", 실험값 "artist type" (results_clarify_v10_corrections)
# CLARIFY_RERANK_INPUT_ORDER=bonus    # pre_bonus면 답을 쓰는 리랭커의 입력에만 보너스 전 순서를 넘긴다, placebo:<seed>면 답 없이 같은 폭으로 섞는 위약 (실험, results_clarify_v11_prebonus)
# GEMINI_RERANK_PASS_RESERVE_SECONDS=10  # 예산 중 본 패스 몫. Search evidence·희소 사실 검증(켠 경우)은 이만큼 이른 마감을 받아
#                                     # 검증 배치가 예산을 다 써도 본 패스가 한 번은 돈다 (실제 몫 = min(이 값, 요청 제한, 예산/2))
# 상대적 시기("작년", "최근 나온")를 해석하는 기준 연도.
# 비워 두면 실행 시점의 연도를 쓴다 — 해가 바뀌면 같은 질의의 분석이 달라지므로
# 평가 재현성을 위해 고정한다. 분석 캐시 생성(build_analysis_cache)은 기본적으로
# 이 값이 없으면 거부한다.
SEARCH_REFERENCE_YEAR=2026

# 리랭커 합성 계수 — **둘은 쌍이다.** 한쪽만 바꾸면 측정한 적 없는 조합이 된다.
#   작은 spread 구간: CE 민감도 = RERANKER_WEIGHT / RERANKER_SPREAD_REF (= 45)
#   큰 spread 구간  : CE 비중 상한 = RERANKER_WEIGHT
# 2026-09-23 결정(dev 53 + test 23): 비율 45를 유지한 채 상한만 0.90 → 0.45로 낮췄다.
# test에서 q305가 1위로 회복되고 기존 개선 6건을 그대로 지킨다.
RERANKER_WEIGHT=0.45
RERANKER_SPREAD_REF=0.01

# CE가 채점할 후보 수. **검색 후보 풀(candidate_k=30)은 그대로 두고** 앞 N개만 채점한다.
# 채점하지 않은 후보는 검색 순서 그대로 뒤에 붙고, 검색 점수 정규화는 30개 전체 기준이다.
#
# 2026-09-25 채택(dev 57 + test 25): 요청 중앙값 5.09 → 4.21초(−17.4%),
# 82질의에서 평가 지표 동일. 다만 **일반적인 품질 무손실 보장은 아니다** —
# test에서 검색 21위 이하 곡이 top-10에 올라오던 경우 둘이 이제 막힌다(지표는 불변).
# 근거: experiments/reranking/results_v21_ce_topn/RUN_INFO.md
#
# **되돌리려면 0**(전체 채점). 이 값은 리랭커를 만들 때 한 번 읽으므로
# 바꾸든 되돌리든 **서버를 다시 띄워야** 적용된다.
RERANKER_SCORE_TOP_N=20

# --- 랭킹 실험 스위치 (기본 꺼짐) ---
# 검색 1위인 phonetic 가사 표면 일치도 리랭킹 보호 대상에 넣는다.
# 2026-09-23 결정: 꺼짐 유지. 발동 근거가 q219 한 건뿐이고, 잘못 추정한 음차를
# 1위에 고정하는 비용이 있다(test 23건에서는 표본이 없어 발동조차 안 했다).
LYRIC_PROTECT_PHONETIC_TOP1=0
# Cross-Encoder spread가 이 값보다 작으면 재정렬을 아예 생략한다(0이면 끔).
# RERANKER_LOW_CONF_TOP_N과 다르다 — 그쪽은 상위 N개 안에서 여전히 재정렬한다.
# 2026-09-23 결정: 꺼짐 유지. m103 회복과 q310 개선 상실을 맞바꾼다.
RERANKER_MIN_SPREAD=0

# 가사 표면 일치 보호 — 2026-09-23 결정: 현행 유지.
# 1.0을 넘기면 보호가 전부 꺼진다(진단용). exact ×8 · phonetic ×5 · fuzzy ×3 배수도 유지.
LYRIC_PROTECT_MIN_CONFIDENCE=0.80
# 가사 가산점 배율. 0이면 매칭·후보 유입은 두고 가산점만 끈다(대조 실험용).
LYRIC_BOOST_SCALE=1.0
# 명시 가산(제목·아티스트·성별·시기·형태·편성·장르·가사 키워드) 전체에 곱하는 배율. 1.0이 현행.
# 0.2는 dev +2 · test −1이라 채택하지 않았다(experiments/reranking/results_v27_boost_scale/RUN_INFO.md)
BOOST_SCALE=1.0
# 일반 속성 가산(성별·발매 시기·솔로/그룹 형태·편성·장르)에만 곱하는 배율. 제목·아티스트·가사 가산은 그대로. 1.0이 현행.
# 0.2는 dev 손실 0에 확장 Hit@10 +2 (experiments/reranking/results_v31_attr_boost_scale/RUN_INFO.md). test는 v09 질의 세트 뒤에
ATTR_BOOST_SCALE=1.0
# 보컬 성별 불일치 감점 배율. 기본 0 = 감점 없음(기록도 없음). 1.0이면 예전 감점(일치 가산과 같은 크기)
GENDER_MISMATCH_SCALE=0
# 장르만 떼어 본 실험 배율 둘(0~1, 기본 1.0 = 현행). 등록 장르와 사용자가 기억하는 장르가 다를 때를 재려는 것이다
# (experiments/genre_memory_gap/RUN_INFO.md). 0이면 그 가산과 기록이 없다. 1보다 큰 값은 1로 읽는다.
#   GENRE_MATCH_SCALE   최초 질의의 장르 일치 가산(genre_match)에만 곱한다. 성별·시기·형태 가산은 그대로
#   GENRE_ANSWER_SCALE  재질문 장르 답변의 가산에만 곱한다. 성별 답변·일치 판정·거절은 그대로
GENRE_MATCH_SCALE=1.0
GENRE_ANSWER_SCALE=1.0
# 속성 조건 보조 후보(실험 스위치, 기본 꺼짐 — experiments/reranking/results_v51_attr_filter/RUN_INFO.md). 분석의 발매 시기 창과
# 성별/장르/형태 조건에 맞는 곡 안에서 같은 질의를 한 번 더 검색해 낮은 RRF 가중으로 더한다. v51 측정(가중 0.5 · era_plus):
# dev 176 Hit@10 117→123, 손실 1(t026). 재질문 답(성별·장르·형태·시기·출생 연도)은 필터 조건에 반영된다.
#   ATTR_FILTER_WEIGHT  RRF 가중(기본 0 = 경로 없음, 현행과 같다). 측정값은 0.5
#   ATTR_FILTER_GATE    여는 조건. era_plus(기본, 시기 창 + 다른 축 1개 이상) | two_axes(시기 없이 두 축도 — 비교용, 손실이 있었다)
#   ATTR_FILTER_K       보조 검색으로 받는 곡 수(기본 30, 1~100)
#   ATTR_FILTER_USE_GENRE  장르를 필터 축에 넣는가(기본 1 = v51·v52 조건). 0이면 시기·성별·형태만 — 사용자가 기억한 장르와 등록 장르가
#                       달라 정답이 보조 목록에서 빠지는 경우(v52 손실 5건 중 4건)를 줄이려는 비교 실험(v53). 시기+장르만 있는 질의는 경로가 닫힌다.
#                       장르 가산·재질문 장르 답 가산은 이 값과 무관하다
#   ATTR_FILTER_GENRE_POLICY  장르 축의 요청 단위 정책(v54 실험, 기본 always = 장르가 있으면 넣음). conditional이면 재질문에서 직접 답한
#                       유효한 장르는 넣고, 그런 답이 없는데 유효한 성별 조건이 있으면 최초 질의의 장르를 조건·게이트 축에서 빼고,
#                       둘 다 아니면 넣는다. ATTR_FILTER_USE_GENRE=0이 우선한다(그때는 정책과 무관하게 장르 없음)
ATTR_FILTER_WEIGHT=0
ATTR_FILTER_GATE=era_plus
ATTR_FILTER_K=30
ATTR_FILTER_USE_GENRE=1
ATTR_FILTER_GENRE_POLICY=always

# 5. MongoDB — 가사 정확 일치 검색에 사용
#    없으면 그 경로만 비고 나머지 검색은 그대로 동작한다
MONGO_URI="mongodb://localhost:27017"
MONGO_DB_NAME="vaguefinder"

# 정답 피드백 수집 — 기본 꺼짐. 켜면 검색 표시 기록과 정답·사유를 위 Mongo에 30일 보관한다.
# 운영/평가 환경에서 명시적으로 선택해 켠다. 세 스위치는 서로 독립이다(docs/feedback.md).
FEEDBACK_COLLECTION_ENABLED=0
# 사용 중인 코퍼스 배포판을 식별하는 값. 예: corpus5143-20261012-bm25-bf606b19ab02
# 비워 두면 수집 기록에는 unknown으로 남는다. 수집 활성화 전에 설정한다.
FEEDBACK_CORPUS_VERSION=unknown
# 승인 사례 색인 + 만료·무효 사례 정리 — 기본 꺼짐. 검색 서버 안의 스레드로 돈다(로컬 Qdrant는 서버만 연다).
# 수집을 꺼도 켜 둘 수 있다 — 쌓인 자료의 만료 정리는 수집 스위치에 묶이지 않는다.
FEEDBACK_INDEX_WORKER_ENABLED=0
# 승인 사례로 검색 후보를 보충 — 기본 꺼짐. 평가 기준(docs/feedback.md §8)을 넘긴 뒤에만 켠다.
FEEDBACK_RETRIEVAL_ENABLED=0
# 아래는 잠정값이다. 비우면 기본값을 쓴다. 범위를 벗어나거나 nan·inf면 기본값으로 읽는다.
# FEEDBACK_MIN_SIMILARITY=0.65       # 질의와 사례 문장의 코사인 유사도 문턱
# FEEDBACK_SUPPLEMENT_SONGS=3        # 한 검색에서 보충할 곡 수 상한
# FEEDBACK_FUSION_WEIGHT=1.0         # 진입 판정 점수 = 밀려날 꼬리 후보의 융합 점수 × 이 값(들어온 곡의 자리는 항상 후보 끝)
# FEEDBACK_LOOKUP_BUDGET_SECONDS=0.6 # 기존 경로가 끝난 뒤 보충을 더 기다리는 상한
# FEEDBACK_WORKER_INTERVAL_SECONDS=60
# 로컬 검토 화면(별도 실행: venv/bin/python -m src.feedback.review_app). loopback에서만 뜬다.
# FEEDBACK_REVIEW_PORT=8001
# FEEDBACK_REVIEWER=                 # 검토 기록에 남길 이름(로컬 설정값 — 확인된 신원이 아니다)

# 6. 크롤러 — 수집을 돌리는 사람만 필요
#    수집 폴더는 팀 구글 드라이브를 가리켜야 한다. **적지 않으면 저장소 안(data/raw)에 쌓인다.**
#    Windows: VAGUEFINDER_DATA_DIR="C:\\Users\\<사용자>\\My Drive\\vague-finder\\raw5"
#    macOS:   VAGUEFINDER_DATA_DIR="/Users/<사용자>/Library/CloudStorage/GoogleDrive-<계정>/내 드라이브/vague-finder/raw5"
VAGUEFINDER_DATA_DIR=
# VAGUEFINDER_STAGING_DIR=           # 진행 중인 곡 폴더. 기본값은 DATA_DIR + "_incomplete"
# ENABLE_NAMUWIKI=1                  # 기본 0(꺼짐). flat 나무위키 수집은 은퇴했다(#67)
#
# 오디오 임베딩 — 아래 값을 바꾸면 곡 벡터와 평균 벡터가 자동으로 재생성된다
#                (전처리 지문이 manifest에 기록된다). Qdrant 재적재가 필요하다.
# AUDIO_DECODER=torchaudio           # 기본 ffmpeg. 비교 측정용이며 실패 시 예외가 난다
# CLAP_SEED=0                        # CLAP 특징 추출 구간 선택 시드. 재현성을 위해 고정
#
# 크롤링에 필수인 것은 위 Gemini 설정(3)과 VAGUEFINDER_DATA_DIR 둘뿐이다.
# 별도 설치가 필요한 것: Node.js(yt-dlp가 js_runtimes로 지정), ffmpeg(오디오 m4a 변환)

# The current router factory supplies these values explicitly.
# CONTEXT_WEIGHT > 0 이면 서버 기동 때 Context 별칭 2개·대상 컬렉션·상태 manifest·로컬 artifact 해시를 확인하고,
# 별칭 누락·불일치 같은 설정 오류면 서버가 뜨지 않는다(연결 장애는 경고만, /health.context=unavailable).
# 0 이면 Context 경로와 이 검사를 함께 끈다. 절차: docs/namuwiki_context_vector_db.md "기동 검사".
CONTEXT_WEIGHT=0.5
CONTEXT_NAMED_MEDIA_MULTIPLIER=2.0
CONTEXT_FACT_K=100
CONTEXT_SPARSE_K=100
SEARCH_DEFAULT_CANDIDATE_K=30
