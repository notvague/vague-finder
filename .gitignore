# 공통 규칙만 둔다.
# - 실험 결과 규칙: experiments/ 아래 각 폴더의 .gitignore (결과 폴더별 예외는 그 폴더에)
# - 개인 작업 파일: 각자 .git/info/exclude

# OS
.DS_Store
.AppleDouble
.LSOverride

# 에디터
.idea/
.vscode/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
venv/
env/
ENV/
.venv

# Node.js
node_modules/
npm-debug.log
yarn-error.log

# 로그
*.log
logs/

# 비밀값
.env
cookies.txt
# Vertex AI 서비스 계정 키 (팀 드라이브로만 전달, 절대 커밋·이미지에 넣지 않는다)
secrets/

# 수집 데이터 · 생성 산출물
data/
!data/.gitkeep
# 임베딩 산출물 · 캐시
artifacts/*
!artifacts/bm25_params.json
# 임베딩 벡터(artifacts/embeddings/)는 커밋하지 않는다.
# 가사·앨범 커버·음원에서 뽑은 파생물이라 공개 레포에 올릴 수 없다.
# 팀 드라이브로 공유하고 docs/vector_backend.md 절차대로 내려받는다.
# 지도 화면 데이터도 같은 이유로 커밋하지 않는다 — 수집한 곡 전체 목록(제목·가수·YouTube ID·커버 URL)이다.
# 팀 드라이브에서 받거나 src/pipelines/build_map.py로 다시 만든다.
src/frontend/static/map_data.json
requirements_backup.txt
reports/

# CSV는 기본 제외. 커밋할 표는 아래와 experiments/ 아래 .gitignore에서 되살린다
*.csv
# 질의 작성 양식은 예시 2행뿐이라 곡 목록 노출이 없다
!docs/eval/query_writing_template.csv
