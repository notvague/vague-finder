+# 리랭커 입력에 싣는 단서 대조의 크기 제한. 후보 30곡이 한 프롬프트에 들어가므로 작게 둔다.
+_RERANK_MAX_CLUES_PER_LIST = 6
+_RERANK_MAX_ITEM_CHARS = 70
+_QUOTE_PREFIX = "곡 자료에 이렇게 적혀 있음: "
+
+
+def clue_evidence_for_rerank(
+    query: str, analysis: Any, track: Any, answers: Sequence[Any] = (),
+) -> Dict[str, List[str]]:
+    """곡 하나의 단서 대조 결과를 리랭커 입력 모양으로. 근거 표(`_check_material`)와 **같은 판정**을 쓴다 — 표와 모델이 다른 말을 하지 않게.
+
+    found는 같은 표현이 곡 자료에 있음, partial은 문장 속 낱말이나 더 짧은 태그만 겹침, not_found는 같은 표현을 못 찾음이다.
+    not_found는 그 곡에 없다는 뜻이 아니다. 모델·DB를 부르지 않고 입력을 바꾸지 않는다.
+    """
+    rows = _check_material(query, analysis, track, SongExplain(song_id=str(getattr(track, "id", ""))), (), answers)
+    out: Dict[str, List[str]] = {"found": [], "partial": [], "not_found": []}
+    for row in rows:
+        if row.slot == SLOT_NOT_FOUND:
+            out["not_found"].extend(part for part in row.clue.split(", ") if part)
+            continue
+        name = _short_name(row)
+        if row.status == STATUS_UNVERIFIED:
+            out["not_found"].append(name)
+            continue
+        quote = row.observed.removeprefix(_QUOTE_PREFIX)
+        item = f"{name}: {quote}"
+        if len(item) > _RERANK_MAX_ITEM_CHARS:
+            item = item[: _RERANK_MAX_ITEM_CHARS - 1].rstrip() + "…"
+        out["found" if row.status == STATUS_MATCH else "partial"].append(item)
+    return {key: values[:_RERANK_MAX_CLUES_PER_LIST] for key, values in out.items() if values}
+
+
+_CLUE_SEARCH_MIN_TERMS = 2
+_CLUE_SEARCH_MAX_TERMS = 4
+
+
+def clue_search_terms(query: str, analysis: Any) -> List[str]:
+    """단서별 검색에 쓸 분석 태그. 근거 표가 곡 자료와 대조하는 단서와 같은 범위다.
+
+    원문에 글자 그대로 있는 태그만 쓴다. 장르·성별·시기·형태·OST는 이미 다른 경로와 가산이 다루고, 표지 질의에서는
+    노래를 말하는 절의 태그만 쓴다. 단서가 하나뿐이면 전체 질의 검색과 다를 것이 없어 빈 목록을 돌려준다.
+    """
+    covered = _covered_words(query, analysis)
+    is_visual = bool(getattr(analysis, "has_visual_clue", False)) or has_explicit_visual_clue(query)
+    scope = text_outside_artwork(query) if is_visual else query
+    terms: List[str] = []
+    for tag in getattr(analysis, "korean_tags", []) or []:
+        tag = str(tag or "").strip()
+        norm = _norm(tag)
+        if (
+            not norm or norm in covered or tag in terms or _ERA_TAG_RE.fullmatch(norm)
+            or norm in _FORM_TAGS or norm in _OST_TAGS or _tag_gender(norm) or _tag_genre_word(norm)
+            or not _said_in_query(tag, scope)
+        ):
+            continue
+        terms.append(tag)
+    return terms[:_CLUE_SEARCH_MAX_TERMS] if len(terms) >= _CLUE_SEARCH_MIN_TERMS else []
