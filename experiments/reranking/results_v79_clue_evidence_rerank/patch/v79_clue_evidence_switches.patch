+def _clue_router(hits_by_term):
+    from concurrent.futures import ThreadPoolExecutor
+    router = SearchRouter.__new__(SearchRouter)
+    router._pool = ThreadPoolExecutor(max_workers=2)
+    calls = []
+    def search_text(dense, top_k, alpha, sparse_query=None, **_kw):
+        calls.append((dense, top_k, alpha, sparse_query))
+        result = hits_by_term[dense]
+        if isinstance(result, Exception):
+            raise result
+        return result
+    router._text_svc = SimpleNamespace(search_text=search_text)
+    return router, calls
+
