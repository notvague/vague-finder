+    router, calls = _clue_router({"술": [both, one], "고음": [both]})
+    fused, meta, recorder = _run_clue_paths(router)
+    scores = dict(fused)
+    assert scores["both"] > scores["one"], "여러 단서에 걸친 곡이 위로 간다"
+    assert fused == sorted(fused, key=lambda item: item[1], reverse=True)
+    assert meta["both"] is both and scores["base"] == 0.02
+    assert any("술자리" in call[3] for call in calls if call[0] == "술"), "짧은 단서는 허용 값을 함께 찾는다"
+    assert [p.path for p in recorder.record.get("both").paths] == ["clue_path", "clue_path"]
