+def _run_clue_paths(router, excluded=None):
+    import asyncio
+    from src.retrieval.explain import ExplainRecorder
+    analysis = _analysis(korean_tags=["술", "고음"])
+    meta = {}
+    recorder = ExplainRecorder(QUERY)
+    async def go():
+        return await router._apply_clue_paths(analysis, [("base", 0.02)], meta, excluded, 0.5, recorder, asyncio.get_running_loop())
+    return asyncio.run(go()), meta, recorder
+
