+    assert _query_embeds(service) == _query_embeds(off_service)   # 임베딩 호출이 늘지 않는다
+    assert [c["sink"] for c in service.calls] == [True]           # 본 경로에만 칸을 준다
+
+
+def test_vector_is_embedded_once_more_when_the_dense_sentence_differs() -> None:
+    analysis = _analysis(original_query=QUERY, intent_type="mixed", lyric_semantic_query="이별 뒤의 그리움")
+    _, off_service, _ = _search(None, analysis)
+    _, service, record = _search(_runtime(), analysis)
+    rec = record.description_semantic
+    assert rec["vector_source"] == "own_embed" and rec["embed_ms"] is not None and rec["status"] == "applied"
+    extra = list(_query_embeds(service))
+    for p in _query_embeds(off_service):
+        extra.remove(p)
+    assert extra == [f"query: {QUERY}"]                            # search_text 그대로 한 번 더
+    assert not any(c["sink"] for c in service.calls)
+    assert rec["aux_ids"] == ["t21", "203", "204", "205"]          # 같은 search_text 벡터 → 같은 결과
+
+
+def test_vector_is_embedded_by_the_aux_path_when_the_text_path_fails_first() -> None:
+    ids, service, record = _search(_runtime(), text_raises=RuntimeError("text down"))
+    rec = record.description_semantic
+    assert rec["vector_source"] == "own_after_text_path_failure" and rec["status"] == "no_base_candidates"
+    assert _query_embeds(service) == [f"query: {QUERY}"]
+
+
+def test_concurrent_requests_do_not_share_vectors() -> None:
+    other = "다른 질의"
+    table = {f"query: {QUERY}": QUERY_VEC, f"query: {other}": _e((4, 1))}   # 다른 질의 → g4가 1위
+    router, _service = _setup(_runtime(), table=table)
+    recs = [ExplainRecorder("a"), ExplainRecorder("b")]
+    analyses = [_analysis(original_query=QUERY, intent_type="mixed"), _analysis(original_query=other, intent_type="mixed")]
+
+    async def both():
+        return await asyncio.gather(*(router.search(a, top_k=30, use_rerank=False, candidate_k=30, recorder=r)
+                                      for a, r in zip(analyses, recs)))
+
+    try:
+        asyncio.run(both())
+    finally:
+        router.shutdown()
+    assert [g["group"] for g in recs[0].record.description_semantic["groups"]][0] == "g1"
+    assert [g["group"] for g in recs[1].record.description_semantic["groups"]][0] == "g4"
+    assert all(r.record.description_semantic["vector_source"] == "shared_text_path" for r in recs)
+
