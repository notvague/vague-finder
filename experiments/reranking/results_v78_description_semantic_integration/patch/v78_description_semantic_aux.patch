+"""앨범 소개 의미 보조(v78, 기본 꺼짐) — 저장소 규칙·빌드·라우터 연결·질의 벡터 재사용·기동 검사. 모델·DB·네트워크 없음.
+
+**합성 자료로 배선과 계약을 확인한다.** 검색 품질의 증거가 아니다. 벡터·곡·제목은 모두 시험용으로 지어낸 것이다.
+"""
+from __future__ import annotations
+
+import asyncio
+import gzip
+import hashlib
+import json
+from pathlib import Path
+
+import numpy as np
+import pytest
+
+from src.retrieval import description_semantic_aux as dsa
+from src.retrieval import search_router as sr
+from src.retrieval.explain import PATH_LABELS, ExplainRecorder
+from src.retrieval.user_explanation import _PATH_SEARCH_NAMES
+from tests.test_search_explain import _analysis, _router, _run, _track
+
+D = dsa.DIM
+
+
+def _e(*pairs) -> np.ndarray:
+    """(차원, 값) 쌍으로 만든 정규화 벡터."""
+    v = np.zeros(D, dtype=np.float32)
+    for i, x in pairs:
+        v[i] = x
+    return (v / np.linalg.norm(v)).astype(np.float32)
+
+
+# ---------------------------------------------------------------------------
+# 합성 저장소: g1(t21·202, 청크 2개) · g2(203) · g3(204) · g4(205)
+# ---------------------------------------------------------------------------
+
+GROUPS = ["g1", "g2", "g3", "g4"]
+GROUP_SONGS = [["202", "t21"], ["203"], ["204"], ["205"]]
+
+
+def _structure(rows=None, group_songs=None, groups=None, dense_ids=None) -> dict:
+    return {"schema_version": dsa.SCHEMA_VERSION, "rule_version": dsa.RULE_VERSION,
+            "groups": groups or GROUPS, "group_songs": group_songs or GROUP_SONGS,
+            # (묶음 번호, 청크 번호, 벡터 행, 제목이 나오는 곡)
+            "rows": rows or [[0, 0, 0, []], [0, 1, 1, ["t21"]], [1, 0, 2, ["203"]], [2, 0, 3, []], [3, 0, 4, []]],
+            "dense_ids": dense_ids or ["202", "203", "204", "205", "t21"]}
+
+
+def _vectors() -> np.ndarray:
+    return np.stack([_e((0, 1)), _e((1, 1)), _e((2, 1)), _e((3, 1)), _e((4, 1))])
+
+
+def _member_dense() -> np.ndarray:
+    return np.stack([_e((10, 1)), _e((11, 1)), _e((12, 1)), _e((13, 1)), _e((14, 1))])
+
+
+def _store(**kw) -> dsa.DescriptionSemanticStore:
+    return dsa.DescriptionSemanticStore(_structure(**kw), _vectors(), _member_dense())
+
+
+QUERY = "경연에서 우승한 사람 노래"
+QUERY_VEC = _e((0, 0.2), (1, 0.9), (2, 0.5), (3, 0.3), (4, 0.1))   # g1(청크 1) > g2 > g3 > g4
+
+
+class _Embedder:
+    """KoE5 대역. 입력 문장 → 정해 둔 벡터(없으면 다른 축의 벡터). 호출을 남긴다."""
+
+    model_name = dsa.MODEL_NAME
+
+    def __init__(self, table=None):
+        self.table = dict(table or {})
+        self.calls: list = []
+
+    def embed_passages(self, passages, *, add_e5_prefix=True, normalize=True, batch_size=64, show_progress_bar=False):
+        self.calls.append(list(passages))
+        return np.stack([self.table.get(p, _e((500, 1))) for p in passages])
+
+
+class _TextService:
+    """본 텍스트 경로 대역 — 실제 서비스처럼 `"query: " + dense 문장`을 임베딩하고 sink에 넘긴 뒤 정해 둔 목록을 돌려준다."""
+
+    def __init__(self, hits, catalogue, embedder, *, fetch_raises=None, text_raises=None):
+        self._hits = hits
+        self._catalogue = catalogue
+        self.text_embedder = embedder
+        self._fetch_raises = fetch_raises
+        self._text_raises = text_raises
+        self.calls: list = []
+        self.fetches: list = []
+
+    def search_text(self, query, top_k=10, alpha=0.5, sparse_query=None, metadata_filter=None, dense_vector_sink=None):
+        self.calls.append({"query": query, "top_k": top_k, "sink": dense_vector_sink is not None})
+        if self._text_raises:
+            raise self._text_raises
+        vec = self.text_embedder.embed_passages([f"query: {query}"], add_e5_prefix=False, normalize=True)[0]
+        if dense_vector_sink is not None:
+            dense_vector_sink(query, vec)
+        return [t.model_copy() for t in self._hits[:top_k]]
+
+    def fetch_tracks_by_ids(self, song_ids):
+        self.fetches.append(list(song_ids))
+        if self._fetch_raises:
+            raise self._fetch_raises
+        return {sid: self._catalogue[sid].model_copy() for sid in song_ids if sid in self._catalogue}
+
+    def track_from_match(self, match):
+        return _track(str(match.get("id")))
+
+
+def _runtime(**kw) -> dsa.DescriptionSemanticRuntime:
+    return dsa.DescriptionSemanticRuntime(_store(**kw), dsa.WEIGHT_WHEN_ON)
+
+
+def _setup(runtime=None, *, n_text=40, lyrics_hits=None, table=None, catalogue=None, **svc_kw):
+    text_hits = [_track(f"t{i}", title=f"텍스트{i}") for i in range(1, n_text + 1)]
+    if catalogue is None:
+        catalogue = {sid: _track(sid, title=f"소개곡{sid}") for sid in ("202", "203", "204", "205")}
+        catalogue["t21"] = text_hits[20] if n_text >= 21 else _track("t21")
+    embedder = _Embedder(table if table is not None else {f"query: {QUERY}": QUERY_VEC})
+    service = _TextService(text_hits, catalogue, embedder, **svc_kw)
+    router = _router(text_hits, lyrics_hits=lyrics_hits)
+    router._text_svc = service
+    router._description_semantic = runtime
+    return router, service
+
+
+def _search(runtime=None, analysis=None, **kw):
+    setup_kw = {k: kw.pop(k) for k in ("n_text", "lyrics_hits", "table", "catalogue", "fetch_raises", "text_raises")
+                if k in kw}
+    router, service = _setup(runtime, **setup_kw)
+    rec = ExplainRecorder("q")
+    analysis = analysis or _analysis(original_query=QUERY, intent_type="mixed", korean_tags=["경연", "우승"])
+    before = analysis.model_dump()
+    kw.setdefault("candidate_k", 30)
+    results = _run(router, analysis, top_k=kw.pop("top_k", 30), use_rerank=False, recorder=rec, **kw)
+    assert analysis.model_dump() == before, "분석 객체를 바꾸면 안 된다"
+    return [t.id for t in results], service, rec.record
+
