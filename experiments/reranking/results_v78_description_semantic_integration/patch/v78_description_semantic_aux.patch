+    index_dir, songs_path, text_dense_dir = Path(index_dir), Path(songs_path), Path(text_dense_dir)
+    index_manifest_path = index_dir / "manifest.json"
+    index_manifest = json.loads(index_manifest_path.read_text(encoding="utf-8"))
+    if index_manifest.get("rule_version") != RULE_VERSION:
+        raise DescriptionSemanticStoreError("v77 색인의 규칙 판이 다르다")
+    fps = index_manifest.get("fingerprints") or {}
+    for key, name in (("vectors_sha256", "vectors.npy"), ("chunks_file_sha256", "chunks.jsonl.gz"),
