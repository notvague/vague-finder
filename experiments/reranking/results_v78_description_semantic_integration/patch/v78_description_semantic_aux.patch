+    manifest = json.loads((out / dsa.MANIFEST_FILE).read_text(encoding="utf-8"))
+    (out / dsa.MANIFEST_FILE).write_text(json.dumps({**manifest, "rule_version": "x"}), encoding="utf-8")
+    with pytest.raises(dsa.DescriptionSemanticStoreError, match="규칙 판"):
+        dsa.DescriptionSemanticStore.load(out)
+
