+def test_load_rejects_changed_files_and_versions(tmp_path: Path) -> None:
+    index, songs, dense = _v77_like(tmp_path)
+    out = tmp_path / "runtime"
+    dsa.main(["build", "--index-dir", str(index), "--songs", str(songs), "--text-dense-dir", str(dense), "--out", str(out)])
+    np.save(index / "vectors.npy", _vectors() * 0.5)            # 색인 벡터가 바뀌었다
+    with pytest.raises(dsa.DescriptionSemanticStoreError, match="vectors.npy"):
+        dsa.DescriptionSemanticStore.load(out)
+    with pytest.raises(dsa.DescriptionSemanticStoreError):
