+@pytest.mark.parametrize("case", ["exact_lyric", "ablation", "no_query_text", "empty", "fetch_error", "bad_vector"])
+def test_non_applied_outcomes_keep_existing_results(case) -> None:
+    analysis = None
+    kw: dict = {}
+    if case == "exact_lyric":
+        analysis = _analysis(original_query=QUERY, intent_type="mixed", lyric_clues=[{"kind": "verbatim", "text": "한 소절"}])
+    elif case == "ablation":
+        kw["disable_boost"] = True
+    elif case == "no_query_text":
+        analysis = _analysis(original_query="")
+    elif case == "empty":
+        kw["catalogue"] = {}                     # 대표곡이 텍스트 색인에 없다 — 정상 0건
+    elif case == "fetch_error":
+        kw["fetch_raises"] = ConnectionError("down")
+    elif case == "bad_vector":
+        kw["table"] = {f"query: {QUERY}": np.ones(8, dtype=np.float32)}
+    off_ids, off_service, _ = _search(None, analysis, **{k: v for k, v in kw.items()
+                                                         if k not in ("fetch_raises", "table", "catalogue")})
+    ids, service, record = _search(_runtime(), analysis, **kw)
+    assert ids == off_ids
+    assert [c["query"] for c in service.calls] == [c["query"] for c in off_service.calls]
+    rec = record.description_semantic
+    assert rec["aux_ids"] == [] and rec["entered_ids"] == [] and rec["displaced_ids"] == []
+    expected = {"exact_lyric": "not_triggered:exact_lyric", "ablation": "not_triggered:ablation",
+                "no_query_text": "not_triggered:no_query_text", "empty": "no_aux_songs",
+                "fetch_error": "failed:ConnectionError", "bad_vector": "failed:QueryVectorError"}[case]
+    assert rec["status"] == expected
+    # 경로 오류만 경로 실패로 남는다 — 정상 0건·정책상 생략과 구분된다
+    assert ("description_semantic_aux" in record.failed_paths) == case.endswith(("_error", "_vector"))
+    if case in ("exact_lyric", "ablation", "no_query_text"):
+        assert service.fetches == [] and not any(c["sink"] for c in service.calls)
+    if case == "empty":
+        assert rec["missing_ids"] == ["t21", "203", "204", "205"]
