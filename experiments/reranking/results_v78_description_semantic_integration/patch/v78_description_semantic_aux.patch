+    if (index_manifest.get("inputs") or {}).get("corpus_sha256") != corpus_sha:
+        raise DescriptionSemanticStoreError("코퍼스 sha가 v77 색인을 만든 코퍼스와 다르다")
+    model = index_manifest.get("model") or {}
+    if model.get("name") != MODEL_NAME or model.get("revision") != MODEL_REVISION or int(model.get("dim", 0)) != DIM:
+        raise DescriptionSemanticStoreError("v77 색인의 모델·차원이 다르다")
+
+    groups = _read_jsonl_gz(index_dir / "groups.jsonl.gz")
+    group_ids = [str(g["group"]) for g in groups]
+    if group_ids != sorted(group_ids) or len(set(group_ids)) != len(group_ids):
+        raise DescriptionSemanticStoreError("v77 묶음 목록이 묶음 id 순이 아니거나 중복이 있다")
+    group_index = {gid: i for i, gid in enumerate(group_ids)}
+    group_songs = [[str(s) for s in g["songs"]] for g in groups]
+    member_ids = sorted({s for songs in group_songs for s in songs}, key=song_sort_key)
+
+    titles: Dict[str, str] = {}
+    with songs_path.open(encoding="utf-8") as fh:
+        for line in fh:
+            if not line.strip():
+                continue
+            rec = json.loads(line)
+            titles[str(rec["song_id"])] = str((rec.get("metadata") or {}).get("title") or "")
+    missing_titles = [s for s in member_ids if s not in titles]
+    if missing_titles:
+        raise DescriptionSemanticStoreError(f"코퍼스에 없는 묶음 곡: {missing_titles[:3]}")
+    title_key = {s: normalize_title_key(titles[s]) for s in member_ids}
+
+    rows: List[list] = []
+    last = (-1, -1)
+    for row in _read_jsonl_gz(index_dir / "chunks.jsonl.gz"):
+        gi = group_index[str(row["group"])]
+        ci = int(row["chunk"])
+        if (gi, ci) <= last:
+            raise DescriptionSemanticStoreError("v77 청크 행이 (묶음, 청크 번호) 순이 아니다")
+        last = (gi, ci)
+        key = normalize_chunk_key(str(row["text"]))
+        titled = [s for s in group_songs[gi] if len(title_key[s]) >= MIN_TITLE_CHARS and title_key[s] in key]
+        rows.append([gi, ci, int(row["u"]), titled])
+
+    dense_ids: List[str] = []
+    dense_rows: List[np.ndarray] = []
+    dense_missing: List[str] = []
+    for sid in member_ids:
+        path = text_dense_dir / f"{sid}.npy"
+        if path.is_file():
+            dense_ids.append(sid)
+            dense_rows.append(np.load(path).astype(np.float32).reshape(-1))
+        else:
+            dense_missing.append(sid)
+    dense = np.stack(dense_rows).astype(np.float32) if dense_rows else np.zeros((0, DIM), dtype=np.float32)
+    if dense.shape[1] != DIM:
+        raise DescriptionSemanticStoreError("기존 텍스트 dense 벡터 차원이 다르다")
+
+    structure = {"schema_version": SCHEMA_VERSION, "rule_version": RULE_VERSION, "groups": group_ids,
+                 "group_songs": group_songs, "rows": rows, "dense_ids": dense_ids}
+    manifest = {
+        "schema_version": SCHEMA_VERSION, "rule_version": RULE_VERSION,
+        "generated_at": datetime.now(timezone.utc).isoformat(),
+        "model": {"name": MODEL_NAME, "revision": MODEL_REVISION, "dim": DIM, "query_prefix": QUERY_PREFIX,
+                  "normalize": True},
+        "index": {"dir_name": index_dir.name, "manifest_sha256": _sha256_file(index_manifest_path),
+                  "vectors_relpath": f"../{index_dir.name}/vectors.npy", "vectors_sha256": fps["vectors_sha256"],
+                  "chunks_file_sha256": fps["chunks_file_sha256"], "groups_file_sha256": fps["groups_file_sha256"]},
+        "sources": {"songs_jsonl": {"path_name": songs_path.name, "sha256": corpus_sha},
+                    "text_dense": {"dir_name": text_dense_dir.name, "loaded": len(dense_ids),
+                                   "missing": dense_missing}},
+        "counts": {"groups": len(group_ids), "chunk_rows": len(rows), "member_songs": len(member_ids),
+                   "rows_with_title": sum(1 for r in rows if r[3]),
+                   "rows_with_multiple_titles": sum(1 for r in rows if len(r[3]) > 1)},
+        "constants": {"groups_k": GROUPS_K, "min_title_chars": MIN_TITLE_CHARS, "weight_when_on": WEIGHT_WHEN_ON},
+    }
+    return structure, dense, manifest
+
+
+def write_runtime(structure: dict, dense: np.ndarray, manifest: dict, out_dir: Path) -> dict:
+    out_dir = Path(out_dir)
+    out_dir.mkdir(parents=True, exist_ok=False)
+    payload = json.dumps(structure, ensure_ascii=False, sort_keys=True).encode("utf-8")
+    (out_dir / STRUCTURE_FILE).write_bytes(gzip.compress(payload, mtime=0))  # 같은 자료면 같은 바이트
+    np.save(out_dir / MEMBER_DENSE_FILE, dense)
+    manifest = dict(manifest, structure_sha256=_sha256_file(out_dir / STRUCTURE_FILE),
+                    member_dense_sha256=_sha256_file(out_dir / MEMBER_DENSE_FILE))
+    (out_dir / MANIFEST_FILE).write_text(json.dumps(manifest, ensure_ascii=False, indent=1) + "\n", encoding="utf-8")
+    return manifest
+
+
+# ---------------------------------------------------------------------- 저장소(메모리 조회만 — 색인·DB 호출 없음)
+
+@dataclass
+class GroupHit:
+    group: str
+    score: float
+    chunk: int
+    representative: str = ""                # 없으면 빈 문자열(목록에서 빠진다)
+    rule: str = "none"                      # title_unique · title_tie_dense · dense · none
+
+
+class DescriptionSemanticStore:
+    def __init__(self, structure: Mapping[str, Any], vectors: np.ndarray, member_dense: np.ndarray,
+                 manifest: Optional[dict] = None) -> None:
+        if structure.get("schema_version") != SCHEMA_VERSION or structure.get("rule_version") != RULE_VERSION:
+            raise DescriptionSemanticStoreError("소개 의미 산출물의 규칙 판이 코드와 다르다")
+        vectors = np.asarray(vectors, dtype=np.float32)
+        member_dense = np.asarray(member_dense, dtype=np.float32)
+        if vectors.ndim != 2 or vectors.shape[1] != DIM or member_dense.ndim != 2 or member_dense.shape[1] != DIM:
+            raise DescriptionSemanticStoreError("소개 의미 산출물의 벡터 차원이 다르다")
+        self.groups: List[str] = [str(g) for g in structure["groups"]]
+        self.group_songs: List[List[str]] = [[str(s) for s in songs] for songs in structure["group_songs"]]
+        rows = structure["rows"]
+        if len(self.group_songs) != len(self.groups) or not rows:
+            raise DescriptionSemanticStoreError("소개 의미 산출물 형식이 잘못됐다")
+        row_group = np.asarray([int(r[0]) for r in rows], dtype=np.int64)
+        self.row_chunk = [int(r[1]) for r in rows]
+        self.row_u = np.asarray([int(r[2]) for r in rows], dtype=np.int64)
+        self.row_titled: List[List[str]] = [[str(s) for s in r[3]] for r in rows]
+        # 청크 행은 (묶음 번호, 청크 번호) 순이고 모든 묶음이 한 행 이상 있어야 한다 — reduceat 경계가 묶음 경계다
+        if (np.any(np.diff(row_group) < 0) or int(row_group[0]) != 0
+                or len(np.unique(row_group)) != len(self.groups) or int(row_group[-1]) != len(self.groups) - 1):
+            raise DescriptionSemanticStoreError("소개 의미 산출물의 청크 행 순서가 다르다")
+        if int(self.row_u.max()) >= vectors.shape[0] or int(self.row_u.min()) < 0:
+            raise DescriptionSemanticStoreError("청크 행이 색인 벡터 범위 밖을 가리킨다")
+        self.group_starts = np.flatnonzero(np.r_[True, np.diff(row_group) != 0]).astype(np.int64)
+        self.group_ends = np.r_[self.group_starts[1:], len(rows)].astype(np.int64)
+        self.group_order_key = np.arange(len(self.groups), dtype=np.int64)  # 묶음 id 오름 = 번호 오름
+        if self.groups != sorted(self.groups):
+            raise DescriptionSemanticStoreError("소개 의미 산출물의 묶음이 id 순이 아니다")
+        dense_ids = [str(s) for s in structure["dense_ids"]]
+        if len(dense_ids) != member_dense.shape[0]:
+            raise DescriptionSemanticStoreError("곡 dense 행 수가 목록과 다르다")
+        self.dense_row = {sid: i for i, sid in enumerate(dense_ids)}
+        self.vectors = vectors
+        self.member_dense = member_dense
+        self.manifest = dict(manifest or {})
+
+    @classmethod
+    def load(cls, runtime_dir: Path) -> "DescriptionSemanticStore":
+        runtime_dir = Path(runtime_dir)
+        mpath = runtime_dir / MANIFEST_FILE
+        if not mpath.is_file():
+            raise DescriptionSemanticStoreError(f"소개 의미 산출물이 없다: {runtime_dir.name}")
+        manifest = json.loads(mpath.read_text(encoding="utf-8"))
+        if manifest.get("schema_version") != SCHEMA_VERSION or manifest.get("rule_version") != RULE_VERSION:
+            raise DescriptionSemanticStoreError("소개 의미 산출물의 규칙 판이 코드와 다르다")
+        model = manifest.get("model") or {}
+        if model.get("name") != MODEL_NAME or model.get("revision") != MODEL_REVISION or int(model.get("dim", 0)) != DIM:
+            raise DescriptionSemanticStoreError("소개 의미 산출물의 모델이 코드와 다르다")
+        index = manifest.get("index") or {}
+        vectors_path = (runtime_dir / str(index.get("vectors_relpath", ""))).resolve()
+        checks = ((runtime_dir / STRUCTURE_FILE, manifest.get("structure_sha256")),
+                  (runtime_dir / MEMBER_DENSE_FILE, manifest.get("member_dense_sha256")),
+                  (vectors_path, index.get("vectors_sha256")))
+        for path, expected in checks:
+            if not path.is_file():
+                raise DescriptionSemanticStoreError(f"소개 의미 산출물 파일이 없다: {path.name}")
+            if not expected or _sha256_file(path) != expected:
+                raise DescriptionSemanticStoreError(f"소개 의미 산출물 sha가 manifest와 다르다: {path.name}")
+        structure = json.loads(gzip.decompress((runtime_dir / STRUCTURE_FILE).read_bytes()))
+        return cls(structure, np.load(vectors_path), np.load(runtime_dir / MEMBER_DENSE_FILE), manifest)
+
+    def fingerprint(self) -> Dict[str, str]:
+        index = self.manifest.get("index") or {}
+        return {"schema_version": SCHEMA_VERSION, "rule_version": RULE_VERSION,
+                "structure_sha256_16": str(self.manifest.get("structure_sha256", ""))[:16],
+                "member_dense_sha256_16": str(self.manifest.get("member_dense_sha256", ""))[:16],
+                "vectors_sha256_16": str(index.get("vectors_sha256", ""))[:16],
+                "groups": str(len(self.groups)), "chunk_rows": str(len(self.row_chunk))}
+
+    def search(self, query_vector: Any, k: int = GROUPS_K) -> List[GroupHit]:
+        """위 k묶음과 대표곡. 결정적(동점: 묶음 id 오름 · 청크 번호 오름 · song_id 숫자 오름)."""
+        q = np.asarray(query_vector, dtype=np.float32).reshape(-1)
+        if q.shape[0] != DIM or not bool(np.all(np.isfinite(q))):
+            raise QueryVectorError(f"질의 벡터 차원 {q.shape[0]} 또는 유한하지 않은 값")
+        row_scores = (self.vectors @ q)[self.row_u]
+        group_max = np.maximum.reduceat(row_scores, self.group_starts)
+        order = np.lexsort((self.group_order_key, -group_max))[:k]
+        hits: List[GroupHit] = []
+        for gi in order.tolist():
+            start, end = int(self.group_starts[gi]), int(self.group_ends[gi])
+            row = start + int(np.argmax(row_scores[start:end]))  # 같은 최댓값이면 앞 행 = 번호가 작은 청크
+            hit = GroupHit(self.groups[gi], float(group_max[gi]), self.row_chunk[row])
+            hit.representative, hit.rule = self._representative(gi, row, q)
+            hits.append(hit)
+        return hits
+
+    def _representative(self, gi: int, row: int, q: np.ndarray) -> Tuple[str, str]:
+        songs = self.group_songs[gi]
+        titled = self.row_titled[row]
+        if len(titled) == 1:
+            return titled[0], "title_unique"
+        present = [s for s in songs if s in self.dense_row]
+        scores = self.member_dense[[self.dense_row[s] for s in present]] @ q if present else np.zeros(0, np.float32)
+        dense_score = {s: float(v) for s, v in zip(present, scores)}
+        pool = [s for s in (titled or songs) if s in dense_score]
+        if not pool:
+            return "", "none"
+        pool.sort(key=lambda s: (-dense_score[s], song_sort_key(s)))
+        return pool[0], ("title_tie_dense" if titled else "dense")
+
+
+# ---------------------------------------------------------------------- 요청 단위 실행
+
+@dataclass
+class DescriptionSemanticRecord:
+    status: str
+    vector_source: str = ""
+    groups: List[Dict[str, Any]] = field(default_factory=list)
+    aux_ids: List[str] = field(default_factory=list)
+    missing_ids: List[str] = field(default_factory=list)   # 대표곡인데 텍스트 색인 메타데이터가 없어 뺀 곡
+    entered_ids: List[str] = field(default_factory=list)
+    displaced_ids: List[str] = field(default_factory=list)
+    wait_ms: Optional[float] = None
+    embed_ms: Optional[float] = None
+    search_ms: Optional[float] = None
+    fetch_ms: Optional[float] = None
+    versions: Dict[str, str] = field(default_factory=dict)
+
+    def as_dict(self) -> Dict[str, Any]:
+        return asdict(self)
+
+
+EmbedFn = Callable[[str], Any]
+FetchFn = Callable[[List[str]], Mapping[str, Any]]
+
+
+def query_text(analysis: Any) -> str:
+    return str(getattr(analysis, "search_text", "") or "")
+
+
+class DescriptionSemanticRuntime:
+    """산출물 + 가중. 라우터가 주입받아 질의마다 `run`을 부른다."""
+
+    def __init__(self, store: DescriptionSemanticStore, weight: float = WEIGHT_WHEN_ON) -> None:
+        if weight != WEIGHT_WHEN_ON:
+            raise ValueError(f"소개 의미 보조 가중은 {WEIGHT_WHEN_ON}만 허용한다")
+        self.store = store
+        self.weight = float(weight)
+
+    def versions(self) -> Dict[str, str]:
+        return {**self.store.fingerprint(), "weight": f"{self.weight:g}", "groups_k": str(GROUPS_K),
+                "model": MODEL_NAME, "model_revision": MODEL_REVISION[:12]}
+
+    def run(self, analysis: Any, vector: Optional[Any], vector_source: str, embed_fn: EmbedFn,
+            fetch_fn: FetchFn) -> Tuple[DescriptionSemanticRecord, List[Any]]:
+        """(기록, 보조 곡 MatchingTrack 순위 목록). 벡터가 없으면 `embed_fn`으로 직접 만든다.
+
+        예외는 **삼키지 않는다** — 라우터가 경로 실패로 기록하고 융합 목록을 그대로 둔다.
+        """
+        record = DescriptionSemanticRecord(status=STATUS_NO_AUX_SONGS, vector_source=vector_source,
+                                           versions=self.versions())
+        if vector is None:
+            started = time.perf_counter()
+            vector = embed_fn(query_text(analysis))
+            record.embed_ms = round((time.perf_counter() - started) * 1000, 3)
+        started = time.perf_counter()
+        hits = self.store.search(vector)
+        record.search_ms = round((time.perf_counter() - started) * 1000, 3)
+        ordered: List[str] = []
+        for hit in hits:
+            record.groups.append({"group": hit.group, "score": round(hit.score, 6), "chunk": hit.chunk,
+                                  "representative": hit.representative, "rule": hit.rule})
+            if hit.representative and hit.representative not in ordered:
+                ordered.append(hit.representative)
+        if not ordered:
+            return record, []
+        started = time.perf_counter()
+        tracks = fetch_fn(list(ordered))
+        record.fetch_ms = round((time.perf_counter() - started) * 1000, 3)
+        out = [tracks[song_id] for song_id in ordered if song_id in tracks]
+        record.missing_ids = [song_id for song_id in ordered if song_id not in tracks]
+        record.aux_ids = [str(t.id) for t in out]
+        record.status = STATUS_APPLIED if out else STATUS_NO_AUX_SONGS
+        return record, out
+
+
+def aux_weight_from_env() -> float:
+    """`DESCRIPTION_SEMANTIC_AUX_WEIGHT`. 비었거나 `0`이면 꺼짐(0.0). 켤 때는 0.5만 허용한다 — 그 밖은 설정 오류."""
+    raw = os.getenv("DESCRIPTION_SEMANTIC_AUX_WEIGHT", "").strip()
+    if raw in {"", "0"}:
+        return 0.0
+    try:
+        value = float(raw)
+    except ValueError as exc:
+        raise ValueError("DESCRIPTION_SEMANTIC_AUX_WEIGHT는 0(꺼짐) 또는 0.5여야 한다") from exc
+    if not math.isfinite(value) or value != WEIGHT_WHEN_ON:
+        raise ValueError("DESCRIPTION_SEMANTIC_AUX_WEIGHT는 0(꺼짐) 또는 0.5여야 한다")
+    return value
+
+
+def runtime_dir_from_env() -> Path:
+    return Path(os.getenv("DESCRIPTION_SEMANTIC_AUX_PATH", DEFAULT_RUNTIME_DIR))
+
+
+def load_runtime_from_env() -> Optional[DescriptionSemanticRuntime]:
+    """서비스·평가 공용. 꺼져 있으면 None(산출물을 읽지 않는다). 켜져 있으면 반드시 불러온다 — 못 하면 기동 오류."""
+    weight = aux_weight_from_env()
+    if weight <= 0:
+        return None
+    return DescriptionSemanticRuntime(DescriptionSemanticStore.load(runtime_dir_from_env()), weight)
+
+
+def main(argv: Optional[Sequence[str]] = None) -> int:
+    ap = argparse.ArgumentParser(description=(__doc__ or "").split("\n")[0])
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    build = sub.add_parser("build", help="v77 색인에서 런타임 산출물을 만든다(운영 자료는 읽기만)")
+    build.add_argument("--index-dir", type=Path, required=True)
+    build.add_argument("--songs", type=Path, required=True)
+    build.add_argument("--text-dense-dir", type=Path, required=True)
+    build.add_argument("--out", type=Path, required=True)
+    args = ap.parse_args(argv)
+    if args.out.exists():
+        print(f"이미 있다 — 덮어쓰지 않는다: {args.out}", file=sys.stderr)
+        return 2
+    structure, dense, manifest = build_runtime(args.index_dir, args.songs, args.text_dense_dir)
+    manifest = write_runtime(structure, dense, manifest, args.out)
+    print(json.dumps({k: manifest[k] for k in ("counts", "structure_sha256", "member_dense_sha256")},
+                     ensure_ascii=False))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
