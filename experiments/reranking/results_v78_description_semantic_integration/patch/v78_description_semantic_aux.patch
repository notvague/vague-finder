+
+def _sha(path: Path) -> str:
+    return hashlib.sha256(path.read_bytes()).hexdigest()
+
+
+def _write_jsonl_gz(path: Path, rows) -> None:
+    with path.open("wb") as raw, gzip.GzipFile(filename="", mode="wb", fileobj=raw, mtime=0) as gz:
+        for row in rows:
+            gz.write((json.dumps(row, ensure_ascii=False) + "\n").encode("utf-8"))
+
+
+def _v77_like(tmp_path: Path):
+    """v77 색인 모양의 합성 폴더 · 코퍼스 · 기존 dense 폴더."""
+    index = tmp_path / "desc_semantic_v1"
+    index.mkdir()
+    np.save(index / "vectors.npy", _vectors())
+    _write_jsonl_gz(index / "groups.jsonl.gz", [{"group": g, "songs": s} for g, s in zip(GROUPS, GROUP_SONGS)])
+    texts = ["앨범 이야기", "타이틀 T-21 (Remix)", "가상곡203 수록", "소개", "소개 둘"]
+    keys = [(0, 0), (0, 1), (1, 0), (2, 0), (3, 0)]
+    _write_jsonl_gz(index / "chunks.jsonl.gz", [{"group": GROUPS[g], "chunk": c, "u": u, "text": t}
+                                                for u, ((g, c), t) in enumerate(zip(keys, texts))])
+    songs = tmp_path / "songs.jsonl"
+    titles = {"202": "다른곡", "t21": "T-21", "203": "가상곡203", "204": "가", "205": "없는제목"}
+    songs.write_text("".join(json.dumps({"song_id": s, "metadata": {"title": t}}, ensure_ascii=False) + "\n"
+                             for s, t in titles.items()), encoding="utf-8")
+    manifest = {"rule_version": dsa.RULE_VERSION,
+                "model": {"name": dsa.MODEL_NAME, "revision": dsa.MODEL_REVISION, "dim": D},
+                "inputs": {"corpus_sha256": _sha(songs)},
+                "fingerprints": {"vectors_sha256": _sha(index / "vectors.npy"),
+                                 "chunks_file_sha256": _sha(index / "chunks.jsonl.gz"),
+                                 "groups_file_sha256": _sha(index / "groups.jsonl.gz")}}
+    (index / "manifest.json").write_text(json.dumps(manifest), encoding="utf-8")
+    dense = tmp_path / "dense"
+    dense.mkdir()
+    for i, sid in enumerate(["202", "203", "204", "205", "t21"]):
+        np.save(dense / f"{sid}.npy", _member_dense()[i])
+    return index, songs, dense
+
+
+def test_build_computes_title_matches_and_loads_with_fingerprints(tmp_path: Path) -> None:
+    index, songs, dense = _v77_like(tmp_path)
+    out = tmp_path / "runtime"
+    assert dsa.main(["build", "--index-dir", str(index), "--songs", str(songs), "--text-dense-dir", str(dense),
+                     "--out", str(out)]) == 0
+    structure = json.loads(gzip.decompress((out / dsa.STRUCTURE_FILE).read_bytes()))
+    # 제목 일치: "T-21"(괄호 제거·기호 제거 → t21)는 청크 1에, "가상곡203"은 청크 2에. 한 글자 제목 "가"는 세지 않는다
+    assert [r[3] for r in structure["rows"]] == [[], ["t21"], ["203"], [], []]
+    store = dsa.DescriptionSemanticStore.load(out)
+    assert [(h.representative, h.rule) for h in store.search(QUERY_VEC)] == \
+        [(h.representative, h.rule) for h in _store().search(QUERY_VEC)]
+    # 같은 자료면 같은 바이트 · 덮어쓰지 않는다
+    again = tmp_path / "runtime2"
+    dsa.main(["build", "--index-dir", str(index), "--songs", str(songs), "--text-dense-dir", str(dense), "--out", str(again)])
+    assert _sha(again / dsa.STRUCTURE_FILE) == _sha(out / dsa.STRUCTURE_FILE)
+    assert dsa.main(["build", "--index-dir", str(index), "--songs", str(songs), "--text-dense-dir", str(dense),
+                     "--out", str(out)]) == 2
+
