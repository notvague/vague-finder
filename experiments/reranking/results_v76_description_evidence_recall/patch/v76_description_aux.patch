+def _songs() -> dict:
+    """g1 = 같은 앨범 두 곡(201·202), g2 = 203, g3 = 낱말 하나만 맞는 204, g4 = 질의와 무관한 205."""
+    return {
+        "201": {"group": "g1", "terms": {"경연": 2, "우승": 1, "무대": 4}},
+        "202": {"group": "g1", "terms": {"경연": 1, "프로그램": 1}},
+        "203": {"group": "g2", "terms": {"우승": 1, "프로그램": 2}},
+        "204": {"group": "g3", "terms": {"경연": 1, "사랑": 2}},
+        "205": {"group": "g4", "terms": {"사랑": 3}},
+    }
+
+
+def _store(songs: dict | None = None) -> da.DescriptionResidualStore:
+    return da.DescriptionResidualStore(songs or _songs(), {"k1": da.BM25_K1, "b": da.BM25_B})
