@@ -0,0 +1,431 @@
+"""앨범 소개 원문 중 **색인 문서에 없는 낱말**로 찾는 보조 후보 경로(v76, 기본 꺼짐).
+
+텍스트 색인(BM25 sparse 문서)에는 멜론 앨범 소개 원문(`metadata.album_description`)이 아니라 그 요약(`album_summary`)만
+들어간다. 요약은 고유명("…3 Part.4")을 남기고 일반어("경연곡"·"우승"·"오디션 프로그램"·"원곡자")를 버릴 수 있어, 질의가
+곡의 맥락을 일반어로만 말하면 BM25 일치가 0이 된다. 이 모듈은 곡마다 "소개 원문 토큰 − 그 곡의 색인 문서 토큰"(중복 횟수
+유지)을 미리 계산한 **별도 산출물**을 만들고, 검색 때 질의 분석의 `korean_tags`로 그 문서들만 BM25 점수를 매긴다.
+
+- 낱말 사전·질의 id·정답을 쓰지 않는다. 전체 코퍼스에 같은 규칙 하나(`desc_residual_v1`).
+- 토큰화는 색인과 같은 `normalize_for_bm25`, 색인 문서는 같은 `build_sparse_passage`.
+- 소개는 앨범 단위다(같은 앨범 곡들이 같은 소개를 공유). 같은 소개 = 같은 묶음이며, 보조 목록에는 묶음마다 한 곡만
+  싣는다 — 대표 곡은 묶음 안 근거 곡만으로 제한한 기존 텍스트 검색의 첫 곡이다(라우터가 넘기는 `search_text_fn`).
+- 근거 = 질의 토큰과 서로 다른 토큰 `MIN_MATCHED_TERMS`개 이상 겹치는 곡. 낱말 하나 일치는 근거로 치지 않는다.
+- 산출물 sha256·규칙 버전을 manifest에 남기고, 불러올 때 다르면 거부한다(기능을 켤 수 없다).
+
+    venv/bin/python -m src.retrieval.description_aux build --songs data/all_songs.jsonl \
+        --out artifacts/description_aux/description_residual_v1.json.gz
+"""
+
+from __future__ import annotations
+
+import argparse
+from array import array
+import gzip
+import hashlib
+import json
+import math
+import os
+import sys
+import time
+from dataclasses import asdict, dataclass, field
+from datetime import datetime, timezone
+from pathlib import Path
+from typing import Any, Callable, Dict, Iterable, List, Mapping, Optional, Sequence, Tuple
+
+SCHEMA_VERSION = "description_residual_v1"
+RULE_VERSION = "desc_residual_v1"
+
+# 아래 값은 구현 전에 고정했다(v76 RUN_INFO §3). 실행 결과를 보고 바꾸지 않는다.
+MIN_MATCHED_TERMS = 2        # 근거 = 서로 다른 질의 토큰 2개 이상 일치
+GROUPS_K = 10                # 보조 목록에 싣는 소개 묶음 수 = 작품명 보조 목록 상한(AUX_MAX_SONGS)과 같은 값
+WEIGHT_WHEN_ON = 0.5         # 켤 때의 RRF 가중(작품명 보조 기본 가중과 같은 값) — 기본은 꺼짐(0)
+BM25_K1 = 1.2                # 텍스트 색인 bm25_params.json과 같은 값
+BM25_B = 0.75
+
+STATUS_APPLIED = "applied"
+STATUS_NO_EVIDENCE = "no_evidence"
+STATUS_NO_AUX_SONGS = "no_aux_songs"
+STATUS_NOT_TRIGGERED_PREFIX = "not_triggered:"
+STATUS_FAILED_PREFIX = "failed:"
+REASON_EXACT_LYRIC = "exact_lyric"
+REASON_NO_QUERY_TERMS = "no_query_terms"
+REASON_ABLATION = "ablation"
+
+DEFAULT_STORE_PATH = "artifacts/description_aux/description_residual_v1.json.gz"
+
+
+def _sha256_file(path: Path) -> str:
+    h = hashlib.sha256()
+    with open(path, "rb") as f:
+        for chunk in iter(lambda: f.read(1 << 20), b""):
+            h.update(chunk)
+    return h.hexdigest()
+
+
+def description_text(song: Mapping[str, Any]) -> str:
+    metadata = song.get("metadata") or {}
+    return str(metadata.get("album_description") or "").strip()
+
+
+def description_group_id(description: str) -> str:
+    """같은 소개 원문(앞뒤 공백 제거) = 같은 묶음."""
+    return hashlib.sha256(description.encode("utf-8")).hexdigest()[:16]
+
+
+def residual_terms(song: Mapping[str, Any]) -> Dict[str, int]:
+    """소개 원문 토큰 중 그 곡의 색인 문서(`build_sparse_passage`)에 없는 토큰과 횟수. 소개가 없으면 빈 dict."""
+    from src.embedding.text.korean_bm25_tokenizer import normalize_for_bm25
+    from src.embedding.text.passage_builder import build_sparse_passage
+
+    description = description_text(song)
+    if not description:
+        return {}
+    indexed = set(normalize_for_bm25(build_sparse_passage(dict(song))).split())
+    counts: Dict[str, int] = {}
+    for token in normalize_for_bm25(description).split():
+        if token and token not in indexed:
+            counts[token] = counts.get(token, 0) + 1
+    return counts
+
+
+def _module_sha256(module_name: str) -> str:
+    module = sys.modules.get(module_name)
+    path = Path(getattr(module, "__file__", "") or "")
+    return _sha256_file(path) if path.is_file() else ""
+
+
+def build_store(songs_path: Path) -> Tuple[dict, dict]:
+    """코퍼스 전체에 같은 규칙. (저장소, manifest). 저장소는 같은 자료면 같은 바이트가 된다."""
+    import src.embedding.text.korean_bm25_tokenizer  # noqa: F401 - 지문 기록용
+    import src.embedding.text.passage_builder  # noqa: F401
+
+    songs: Dict[str, Dict[str, Any]] = {}
+    seen: set = set()
+    total = with_description = 0
+    with open(songs_path, encoding="utf-8") as f:
+        for line in f:
+            if not line.strip():
+                continue
+            song = json.loads(line)
+            song_id = str(song.get("song_id") or "").strip()
+            if not song_id:
+                raise ValueError("song_id 없는 곡이 있다")
+            if song_id in seen:
+                raise ValueError(f"song_id 중복: {song_id}")
+            seen.add(song_id)
+            total += 1
+            description = description_text(song)
+            if not description:
+                continue
+            with_description += 1
+            terms = residual_terms(song)
+            if terms:
+                songs[song_id] = {"group": description_group_id(description), "terms": terms}
+    df: Dict[str, int] = {}
+    total_tokens = 0
+    for doc in songs.values():
+        total_tokens += sum(doc["terms"].values())
+        for token in doc["terms"]:
+            df[token] = df.get(token, 0) + 1
+    n_docs = len(songs)
+    store = {
+        "schema_version": SCHEMA_VERSION, "rule_version": RULE_VERSION, "songs": songs,
+        "bm25": {"k1": BM25_K1, "b": BM25_B, "n_docs": n_docs,
+                 "avgdl": (total_tokens / n_docs) if n_docs else 0.0, "df": df},
+    }
+    try:
+        from importlib.metadata import version as _version
+
+        kiwi_version = _version("kiwipiepy")
+    except Exception:  # noqa: BLE001 - 기록용
+        kiwi_version = ""
+    groups = {doc["group"] for doc in songs.values()}
+    manifest = {
+        "schema_version": SCHEMA_VERSION,
+        "rule_version": RULE_VERSION,
+        "generated_at": datetime.now(timezone.utc).isoformat(),
+        "song_count": total,
+        "songs_with_description": with_description,
+        "docs": n_docs,
+        "description_groups": len(groups),
+        "residual_tokens": total_tokens,
+        "vocabulary": len(df),
+        "sources": {"songs_jsonl": {"path_name": songs_path.name, "sha256": _sha256_file(songs_path)}},
+        "code": {
+            "korean_bm25_tokenizer_sha256": _module_sha256("src.embedding.text.korean_bm25_tokenizer"),
+            "passage_builder_sha256": _module_sha256("src.embedding.text.passage_builder"),
+            "kiwipiepy": kiwi_version,
+        },
+    }
+    return store, manifest
+
+
+def manifest_path(store_path: Path) -> Path:
+    name = store_path.name
+    for suffix in (".json.gz", ".gz", ".json"):
+        if name.endswith(suffix):
+            name = name[: -len(suffix)]
+            break
+    return store_path.with_name(name + ".manifest.json")
+
+
+def write_store(store: dict, manifest: dict, out: Path) -> dict:
+    out.parent.mkdir(parents=True, exist_ok=True)
+    payload = json.dumps(store, ensure_ascii=False, sort_keys=True).encode("utf-8")
+    out.write_bytes(gzip.compress(payload, mtime=0))  # 시각을 넣지 않는다 — 같은 자료면 같은 바이트
+    manifest = dict(manifest, store_file=out.name, store_sha256=_sha256_file(out))
+    manifest_path(out).write_text(json.dumps(manifest, ensure_ascii=False, indent=1) + "\n", encoding="utf-8")
+    return manifest
+
+
+class DescriptionStoreError(RuntimeError):
+    """산출물이 없거나 manifest·규칙 버전과 맞지 않는다 — 기능을 켤 수 없다."""
+
+
+@dataclass(frozen=True)
+class EvidenceHit:
+    song_id: str
+    group: str
+    score: float
+    matched: Tuple[str, ...]
+
+
+class DescriptionResidualStore:
+    """색인 밖 소개 토큰의 메모리 역색인. 조회는 메모리 안에서만 한다(색인·DB 호출 없음)."""
+
+    def __init__(self, songs: Mapping[str, Mapping[str, Any]], bm25: Mapping[str, Any],
+                 manifest: Optional[dict] = None) -> None:
+        self._ids: List[str] = sorted((str(s) for s in songs), key=lambda s: (len(s), s))
+        index = {song_id: i for i, song_id in enumerate(self._ids)}
+        self._group: List[str] = [str(songs[s]["group"]) for s in self._ids]
+        self._length: List[int] = [int(sum(int(c) for c in songs[s]["terms"].values())) for s in self._ids]
+        # 토큰 → (문서 번호 배열, 횟수 배열). 튜플 목록보다 메모리가 작다(약 64만 항목).
+        postings: Dict[str, Tuple[array, array]] = {}
+        for song_id in self._ids:
+            doc = index[song_id]
+            for token, count in songs[song_id]["terms"].items():
+                if int(count) > 0:
+                    docs, tfs = postings.setdefault(sys.intern(str(token)), (array("I"), array("I")))
+                    docs.append(doc)
+                    tfs.append(int(count))
+        self._postings = postings
+        self.k1 = float(bm25.get("k1", BM25_K1))
+        self.b = float(bm25.get("b", BM25_B))
+        self.n_docs = len(self._ids)
+        self.avgdl = (sum(self._length) / self.n_docs) if self.n_docs else 0.0
+        self.manifest = dict(manifest or {})
+
+    @classmethod
+    def from_store(cls, store: Mapping[str, Any], manifest: Optional[dict] = None) -> "DescriptionResidualStore":
+        if store.get("schema_version") != SCHEMA_VERSION or store.get("rule_version") != RULE_VERSION:
+            raise DescriptionStoreError("소개 잔여 산출물의 규칙 버전이 코드와 다르다")
+        songs, bm25 = store.get("songs"), store.get("bm25")
+        if not isinstance(songs, dict) or not isinstance(bm25, dict):
+            raise DescriptionStoreError("소개 잔여 산출물 형식이 잘못됐다")
+        built = cls(songs, bm25, manifest)
+        if int(bm25.get("n_docs", -1)) != built.n_docs:
+            raise DescriptionStoreError("소개 잔여 산출물의 문서 수가 통계와 다르다")
+        return built
+
+    @classmethod
+    def load(cls, path: Path) -> "DescriptionResidualStore":
+        path = Path(path)
+        mpath = manifest_path(path)
+        if not path.is_file() or not mpath.is_file():
+            raise DescriptionStoreError(f"소개 잔여 산출물이 없다: {path.name}")
+        manifest = json.loads(mpath.read_text(encoding="utf-8"))
+        if manifest.get("schema_version") != SCHEMA_VERSION or manifest.get("rule_version") != RULE_VERSION:
+            raise DescriptionStoreError("소개 잔여 산출물의 규칙 버전이 코드와 다르다")
+        if manifest.get("store_sha256") != _sha256_file(path):
+            raise DescriptionStoreError("소개 잔여 산출물 sha가 manifest와 다르다")
+        return cls.from_store(json.loads(gzip.decompress(path.read_bytes())), manifest)
+
+    def fingerprint(self) -> Dict[str, str]:
+        return {"schema_version": SCHEMA_VERSION, "rule_version": RULE_VERSION,
+                "store_sha256_16": str(self.manifest.get("store_sha256", ""))[:16],
+                "docs": str(self.n_docs)}
+
+    def _idf(self, df: int) -> float:
+        return math.log(1.0 + (self.n_docs - df + 0.5) / (df + 0.5))
+
+    def evidence(self, query_terms: Iterable[str], min_matched: int = MIN_MATCHED_TERMS) -> List[EvidenceHit]:
+        """근거 곡(서로 다른 질의 토큰 `min_matched`개 이상 일치). (점수 내림, 곡 id) 순 — 결정적."""
+        terms = sorted({str(t) for t in query_terms if str(t)})
+        scores: Dict[int, float] = {}
+        matched: Dict[int, List[str]] = {}
+        for token in terms:  # 정렬된 순서로 더한다 — 부동소수 합이 실행마다 같다
+            posting = self._postings.get(token)
+            if not posting:
+                continue
+            docs, tfs = posting
+            idf = self._idf(len(docs))
+            for doc, tf in zip(docs, tfs):
+                norm = self.k1 * (1.0 - self.b + self.b * self._length[doc] / self.avgdl)
+                scores[doc] = scores.get(doc, 0.0) + idf * tf * (self.k1 + 1.0) / (tf + norm)
+                matched.setdefault(doc, []).append(token)
+        hits = [EvidenceHit(self._ids[doc], self._group[doc], scores[doc], tuple(matched[doc]))
+                for doc in scores if len(matched[doc]) >= min_matched]
+        hits.sort(key=lambda h: (-h.score, len(h.song_id), h.song_id))
+        return hits
+
+
+@dataclass
+class DescriptionGroup:
+    group: str
+    score: float
+    members: List[str]                      # 그 묶음의 근거 곡(곡 id 순)
+    matched: List[str]                      # 근거 곡들의 일치 토큰 합집합(정렬)
+    representative: str = ""                # 2단계가 고른 곡. 없으면 빈 문자열(목록에서 빠진다)
+
+
+def top_groups(hits: Sequence[EvidenceHit], k: int = GROUPS_K) -> List[DescriptionGroup]:
+    """묶음 점수 = 근거 곡 점수의 최댓값. (점수 내림, 묶음 id) 순 위 k묶음."""
+    by_group: Dict[str, DescriptionGroup] = {}
+    for hit in hits:
+        group = by_group.get(hit.group)
+        if group is None:
+            by_group[hit.group] = DescriptionGroup(hit.group, hit.score, [hit.song_id], sorted(hit.matched))
+            continue
+        group.score = max(group.score, hit.score)
+        group.members.append(hit.song_id)
+        group.matched = sorted(set(group.matched) | set(hit.matched))
+    groups = sorted(by_group.values(), key=lambda g: (-g.score, g.group))[:k]
+    for group in groups:
+        group.members.sort(key=lambda s: (len(s), s))
+    return groups
+
+
+def query_terms(analysis: Any) -> List[str]:
+    """질의 분석의 `korean_tags`만(색인과 같은 정규화). 제목·가수·가사·원문·영문 질의는 쓰지 않는다. 처음 나온 순서."""
+    from src.embedding.text.korean_bm25_tokenizer import normalize_for_bm25
+
+    tags = [str(t) for t in (getattr(analysis, "korean_tags", None) or []) if str(t).strip()]
+    if not tags:
+        return []
+    return list(dict.fromkeys(t for t in normalize_for_bm25(" ".join(tags)).split() if t))
+
+
+@dataclass
+class DescriptionAuxRecord:
+    status: str
+    query_terms: List[str] = field(default_factory=list)
+    evidence_songs: int = 0
+    groups: List[Dict[str, Any]] = field(default_factory=list)
+    aux_ids: List[str] = field(default_factory=list)
+    entered_ids: List[str] = field(default_factory=list)
+    displaced_ids: List[str] = field(default_factory=list)
+    stage1_ms: Optional[float] = None
+    stage2_ms: Optional[float] = None
+    versions: Dict[str, str] = field(default_factory=dict)
+
+    def as_dict(self) -> Dict[str, Any]:
+        return asdict(self)
+
+
+SearchTextFn = Callable[[List[str], int], List[Any]]
+
+
+class DescriptionAuxRuntime:
+    """산출물 + 가중. 라우터가 주입받아 질의마다 `run`을 부른다."""
+
+    def __init__(self, store: DescriptionResidualStore, weight: float = WEIGHT_WHEN_ON) -> None:
+        if not math.isfinite(weight) or not 0 < weight <= 1:
+            raise ValueError("소개 보조 가중은 0보다 크고 1 이하여야 한다")
+        self.store = store
+        self.weight = float(weight)
+
+    def versions(self) -> Dict[str, str]:
+        return {**self.store.fingerprint(), "weight": f"{self.weight:g}", "groups_k": str(GROUPS_K),
+                "min_matched_terms": str(MIN_MATCHED_TERMS)}
+
+    def run(self, analysis: Any, search_text_fn: SearchTextFn) -> Tuple[DescriptionAuxRecord, List[Any]]:
+        """(기록, 보조 곡 MatchingTrack 순위 목록). 근거 없음·빈 결과는 정상 상태로 남긴다.
+
+        1·2단계 예외는 **삼키지 않는다** — 라우터가 경로 실패로 기록하고 융합 목록을 그대로 둔다.
+        """
+        record = DescriptionAuxRecord(status=STATUS_NO_EVIDENCE, versions=self.versions())
+        record.query_terms = query_terms(analysis)
+        if not record.query_terms:
+            record.status = STATUS_NOT_TRIGGERED_PREFIX + REASON_NO_QUERY_TERMS
+            return record, []
+        started = time.perf_counter()
+        hits = self.store.evidence(record.query_terms)
+        groups = top_groups(hits)
+        record.stage1_ms = round((time.perf_counter() - started) * 1000, 2)
+        record.evidence_songs = len(hits)
+        if not groups:
+            record.status = STATUS_NO_EVIDENCE
+            return record, []
+        allowed = [song_id for group in groups for song_id in group.members]
+        started = time.perf_counter()
+        tracks = list(search_text_fn(allowed, len(allowed)))
+        record.stage2_ms = round((time.perf_counter() - started) * 1000, 2)
+        first_rank: Dict[str, int] = {}
+        by_id: Dict[str, Any] = {}
+        allowed_set = set(allowed)
+        for rank, track in enumerate(tracks):
+            song_id = str(getattr(track, "id", ""))
+            if song_id in allowed_set and song_id not in first_rank:
+                first_rank[song_id] = rank
+                by_id[song_id] = track
+        out: List[Any] = []
+        for group in groups:
+            returned = [s for s in group.members if s in first_rank]
+            if returned:
+                group.representative = min(returned, key=lambda s: first_rank[s])
+                out.append(by_id[group.representative])
+            record.groups.append({"group": group.group, "score": round(group.score, 4),
+                                  "members": list(group.members), "matched": list(group.matched),
+                                  "representative": group.representative})
+        record.aux_ids = [str(t.id) for t in out]
+        record.status = STATUS_APPLIED if out else STATUS_NO_AUX_SONGS
+        return record, out
+
+
+def aux_weight_from_env() -> float:
+    """`DESCRIPTION_AUX_WEIGHT`. 비었거나 `0`이면 꺼짐(0.0). 그 밖에는 0 < 값 ≤ 1인 수여야 한다 — 아니면 설정 오류."""
+    raw = os.getenv("DESCRIPTION_AUX_WEIGHT", "").strip()
+    if raw in {"", "0"}:
+        return 0.0
+    try:
+        value = float(raw)
+    except ValueError as exc:
+        raise ValueError("DESCRIPTION_AUX_WEIGHT는 0(꺼짐) 또는 0보다 크고 1 이하인 수여야 한다") from exc
+    if not math.isfinite(value) or not 0 < value <= 1:
+        raise ValueError("DESCRIPTION_AUX_WEIGHT는 0(꺼짐) 또는 0보다 크고 1 이하인 수여야 한다")
+    return value
+
+
+def store_path_from_env() -> Path:
+    return Path(os.getenv("DESCRIPTION_AUX_PATH", DEFAULT_STORE_PATH))
+
+
+def load_runtime_from_env() -> Optional[DescriptionAuxRuntime]:
+    """서비스·평가 공용. 꺼져 있으면 None(산출물을 읽지 않는다). 켜져 있으면 산출물을 반드시 불러온다 — 못 하면 기동 오류."""
+    weight = aux_weight_from_env()
+    if weight <= 0:
+        return None
+    return DescriptionAuxRuntime(DescriptionResidualStore.load(store_path_from_env()), weight)
+
+
+def main(argv: Optional[Sequence[str]] = None) -> int:
+    ap = argparse.ArgumentParser(description=__doc__.split("\n")[0])
+    sub = ap.add_subparsers(dest="cmd", required=True)
+    build = sub.add_parser("build", help="코퍼스에서 산출물을 만든다(운영 자료는 읽기만)")
+    build.add_argument("--songs", type=Path, required=True)
+    build.add_argument("--out", type=Path, required=True)
+    args = ap.parse_args(argv)
+    if args.cmd == "build":
+        if args.out.exists() or manifest_path(args.out).exists():
+            print(f"이미 있다 — 덮어쓰지 않는다: {args.out}", file=sys.stderr)
+            return 2
+        store, manifest = build_store(args.songs)
+        manifest = write_store(store, manifest, args.out)
+        print(json.dumps({k: manifest[k] for k in ("song_count", "songs_with_description", "docs",
+                                                   "description_groups", "residual_tokens", "vocabulary",
+                                                   "store_sha256")}, ensure_ascii=False))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main())
