+class _TextService:
+    """필터 없는 호출은 기본 목록, `song_id $in` 필터 호출은 카탈로그 순서 그대로 그 곡만 돌려준다. 호출 인자를 남긴다."""
+
+    def __init__(self, hits, catalogue, *, raises=None):
+        self._hits = hits
+        self._catalogue = catalogue
+        self._raises = raises
+        self.calls: list = []
+
+    def search_text(self, query, top_k=10, alpha=0.5, sparse_query=None, metadata_filter=None):
+        self.calls.append({"query": query, "top_k": top_k, "alpha": alpha, "sparse_query": sparse_query,
+                           "metadata_filter": metadata_filter})
+        if not metadata_filter:
+            return [t.model_copy() for t in self._hits[:top_k]]
+        if self._raises:
+            raise self._raises
+        allowed = {str(v) for branch in metadata_filter["$or"] for v in branch["song_id"]["$in"]}
+        return [t.model_copy() for sid, t in self._catalogue.items() if sid in allowed][:top_k]
+
+    def track_from_match(self, match):
+        return _track(str(match.get("id")))
+
+
+def _setup(runtime=None, *, n_text=40, lyrics_hits=None, raises=None, catalogue_order=("202", "201", "203", "204")):
+    text_hits = [_track(f"t{i}", title=f"텍스트{i}") for i in range(1, n_text + 1)]
+    catalogue = {sid: _track(sid, title=f"소개곡{sid}") for sid in catalogue_order}
+    service = _TextService(text_hits, catalogue, raises=raises)
+    router = _router(text_hits, lyrics_hits=lyrics_hits)
+    router._text_svc = service
+    router._description_aux = runtime
+    return router, service
+
+
+def _search(runtime=None, analysis=None, **kw):
+    setup_kw = {k: kw.pop(k) for k in ("catalogue_order",) if k in kw}
+    router, service = _setup(runtime, lyrics_hits=kw.pop("lyrics_hits", None), raises=kw.pop("raises", None),
+                             **setup_kw)
+    rec = ExplainRecorder("q")
+    analysis = analysis or _analysis(original_query="경연에서 우승한 사람 노래", intent_type="mixed", korean_tags=TAGS)
+    before = analysis.model_dump()
+    kw.setdefault("candidate_k", 30)
+    results = _run(router, analysis, top_k=kw.pop("top_k", 30), use_rerank=False, recorder=rec, **kw)
+    assert analysis.model_dump() == before, "분석 객체를 바꾸면 안 된다"
+    return [t.id for t in results], service.calls, rec.record
+
+
+def _main_calls(calls):
+    return [c for c in calls if not c["metadata_filter"]]
+
+
+def _aux_calls(calls):
+    return [c for c in calls if c["metadata_filter"]]
