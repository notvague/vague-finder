+    [aux] = _aux_calls(calls)
+    main = _main_calls(calls)[0]
+    # 2단계 = 기존 텍스트 경로와 같은 dense 문장·sparse 질의·alpha, 근거 곡으로만 제한
+    assert (aux["query"], aux["sparse_query"], aux["alpha"]) == (main["query"], main["sparse_query"], main["alpha"])
+    assert sorted(v for b in aux["metadata_filter"]["$or"] for v in b["song_id"]["$in"] if isinstance(v, str)) == \
+        ["201", "202", "203"]
+    assert set(rec["aux_ids"]) == {"202", "203"}
+    assert rec["entered_ids"] and set(rec["entered_ids"]) <= set(rec["aux_ids"]) <= set(ids) | set(rec["aux_ids"])
+    assert len(ids) == 30 and len(rec["displaced_ids"]) == len(rec["entered_ids"])  # 최종 후보 30 유지
+    assert set(rec["displaced_ids"]) <= set(off_ids) and not set(rec["displaced_ids"]) & set(ids)
+    first = rec["aux_ids"][0]
+    paths = [p for p in record.songs[first].paths if p.path == "description_aux"]
+    assert paths and paths[0].delta == pytest.approx(1.0 / (sr._RRF_K + 1))
+
+
+def test_default_weight_entrant_must_beat_the_cut() -> None:
