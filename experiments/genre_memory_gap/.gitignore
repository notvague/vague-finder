!/results_*/*/rerank_ranks.csv
!/results_*/genre_word_decomposition.csv
!/results_*/clarify_compare.csv
!/results_*/clarify_*/clarify_summary*.csv
!/results_*/identity_terms/*.csv
!/results_*/*/search_eval_*_summary.csv
!/results_*/*/search_eval_*_top10.csv
!/results_*/*/*/search_eval_*_summary.csv
!/results_*/*/*/search_eval_*_top10.csv
/**/*_explain.jsonl
/**/*.log
/**/progress.txt
